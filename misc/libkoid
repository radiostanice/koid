#!/bin/sh
# Shared utilities for the Koid Linux installer.

# --- Strict error handling ---
set -eu
commandFailure="An unknown error has occurred."

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

_KOID_MISC_DIR="$(pwd)/misc"
if [ -f "${_KOID_MISC_DIR}/dialogrc" ]; then
    export DIALOGRC="${_KOID_MISC_DIR}/dialogrc"
fi
KOID_FILES_DIR="$(pwd)/files"

die() {
    exec 1>&3 2>&4  # Restore original stdout/stderr
    printf "\n[ERROR] %s\n" "${1:-${commandFailure}}" >&2
    cleanup_mounts
    exit 1
}

# Wrapper around xbps-install that logs output and calls die on failure
install() {
    xbps-install -y -U --repository "$repository" --root /mnt "$@" || die
}

# Wrapper around sh -c that calls die on failure
system() {
    sh -c "$@" || die
}

# --- Process Killing ---
# Kills any process inside the chroot, or any host process with its root/cwd inside /mnt.
# ============================================================================
# CLEANUP FUNCTIONS - Replace these entire functions in libkoid
# ============================================================================

kill_chroot_procs() {
  local pids
  local i
  local max_attempts=3

  for attempt in $(seq 1 "$max_attempts"); do
    pids=$(lsof +D /mnt 2>/dev/null | awk 'NR>1 {print $2}' | sort -u)
    
    if [ -z "$pids" ]; then
      return 0
    fi

    _info "Killing processes with open files in /mnt (attempt $attempt/$max_attempts)"
    
    for pid in $pids; do
      if kill -0 "$pid" 2>/dev/null; then
        kill -TERM "$pid" 2>/dev/null || true
      fi
    done

    sleep 0.5

    # Force kill any remaining processes
    for pid in $pids; do
      if kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null || true
      fi
    done

    sleep 0.5
  done

  return 0
}

cleanup_mounts() {
  local i
  local mapper_mounts
  local mount_point

  _info "Starting mount cleanup..."

  # First pass: kill any processes holding files in /mnt
  kill_chroot_procs
  sleep 1

  # Second pass: catch stragglers
  kill_chroot_procs
  sleep 1

  # Drop filesystem caches to release stale inodes
  _info "Dropping filesystem caches..."
  echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
  sync
  sleep 0.5

  # Unmount recursive with retries
  _info "Unmounting /mnt recursively..."
  i=1
  while [ "$i" -le 15 ]; do
    if umount -l -R /mnt 2>/dev/null; then
      _info "Successfully unmounted /mnt"
      break
    fi
    
    if [ "$i" -eq 1 ]; then
      _info "Unmount in progress, retrying..."
    fi
    
    sleep 0.5
    i=$((i + 1))
  done

  if [ "$i" -gt 15 ]; then
    _warn "Could not cleanly unmount /mnt, forcing with lazy unmount..."
  fi

  # Get list of remaining mapper mounts and unmount them
  _info "Cleaning up mapper mounts..."
  mapper_mounts=$(awk '$1 ~ /^\/dev\/mapper\// && $2 !~ /^\/dev/ {print $2}' /proc/mounts 2>/dev/null | sort -r)
  
  for mount_point in $mapper_mounts; do
    i=1
    while [ "$i" -le 3 ]; do
      if umount -l "$mount_point" 2>/dev/null; then
        _info "Unmounted $mount_point"
        break
      fi
      sleep 0.5
      i=$((i + 1))
    done
  done

  sleep 0.5

  # Verify no mounts remain at /mnt
  if findmnt /mnt >/dev/null 2>&1; then
    _warn "Warning: /mnt still has mounted filesystems, attempting forced unmount..."
    umount -f -l /mnt 2>/dev/null || true
    sleep 1
  fi

  # Close LUKS device with retry loop
  _info "Closing LUKS device void_root..."
  if cryptsetup status void_root >/dev/null 2>&1; then
    i=1
    while [ "$i" -le 5 ]; do
      if cryptsetup close void_root 2>/dev/null; then
        _info "Successfully closed void_root"
        break
      fi
      
      # On final attempt, use dmsetup to force remove
      if [ "$i" -eq 4 ]; then
        _warn "Forcing device removal with dmsetup..."
        dmsetup remove --force void_root 2>/dev/null || true
      fi
      
      sleep 1
      i=$((i + 1))
    done
  fi

  # Final verification and cleanup of stale device nodes
  sleep 0.5
  
  if [ -e /dev/mapper/void_root ]; then
    if ! dmsetup info void_root >/dev/null 2>&1; then
      _info "Removing stale /dev/mapper/void_root device node"
      rm -f /dev/mapper/void_root 2>/dev/null || true
    fi
  fi

  # Trigger udev to settle
  udevadm settle 2>/dev/null || true

  _info "Cleanup complete"
  return 0
}

cleanup_on_exit() {
  if [ -n "$commandFailure" ]; then
    _error "Installation failed: $commandFailure"
    cleanup_mounts
  fi
}

drawDialog() {
    dialog --stdout --no-mouse \
           --backtitle "Koid Linux Installer" "$@"
}

drawDialogBack() {
    dialog --stdout --no-mouse --backtitle "Koid Linux Installer" --extra-button --extra-label "Back" "$@"
}

setKernelParam() {
    echo "$1" >> /mnt/etc/kernel/cmdline || die "Failed to set kernel parameter."
    kernelparam_update="true"
    return 0
}

enableService() {
    for service in "$@"; do
        system "ln -sf /etc/sv/$service /var/service"
    done
    return 0
}
