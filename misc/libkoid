#!/bin/sh
# Shared utilities for the Koid Linux installer.

# --- Strict error handling ---
set -eu
commandFailure="An unknown error has occurred."

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

_KOID_MISC_DIR="$(pwd)/misc"
if [ -f "${_KOID_MISC_DIR}/dialogrc" ]; then
    export DIALOGRC="${_KOID_MISC_DIR}/dialogrc"
fi
KOID_FILES_DIR="$(pwd)/files"

die() {
    exec 1>&3 2>&4  # Restore original stdout/stderr
    printf "\n[ERROR] %s\n" "${1:-${commandFailure}}" >&2
    cleanup_mounts
    exit 1
}

# Wrapper around xbps-install that logs output and calls die on failure
install() {
    xbps-install -y -U --repository "$repository" --root /mnt "$@" || die
}

# Wrapper around sh -c that calls die on failure
system() {
    sh -c "$@" || die
}

# --- Process Killing ---
# Kills any process inside the chroot, or any host process with its root/cwd inside /mnt.
kill_chroot_procs() {
    # Kill any process whose root or cwd is /mnt
    for pdir in /proc/[0-9]*; do
        pid=${pdir#/proc/}
        [ "$pid" = "$$" ] && continue
        proot=$(readlink "$pdir/root" 2>/dev/null) || continue
        case "$proot" in
            /mnt|/mnt/*) kill -9 "$pid" 2>/dev/null || true; continue ;;
        esac
        pcwd=$(readlink "$pdir/cwd" 2>/dev/null) || continue
        case "$pcwd" in
            /mnt|/mnt/*) kill -9 "$pid" 2>/dev/null || true; continue ;;
        esac
    done

    # Also kill processes holding files open in /mnt
    if command -v fuser >/dev/null 2>&1; then
        fuser -k -m /mnt 2>/dev/null || true
    fi
}

# --- Robust Cleanup Function ---
cleanup_mounts() {
    # Kill chroot leftovers FIRST, so they don't hold the filesystem busy
    kill_chroot_procs

    # Sync filesystems to flush any dirty page caches.
    # This is CRITICAL to avoid "buffer I/O error" on subsequent runs!
    sync
    swapoff -a 2>/dev/null || true

    # 1. Unmount chroot virtual filesystems explicitly
    for fs in proc sys dev/pts dev/shm dev run tmp; do
        umount -f "/mnt/$fs" 2>/dev/null || true
    done

    # 2. Recursively unmount everything under /mnt in reverse alphabetical order.
    # We do not use "umount -l -R" because:
    # a) "-R" is not POSIX compliant (BusyBox umount doesn't have it).
    # b) "-l" (lazy) detaches the mount from the namespace but leaves the kernel
    #    VFS attached with dirty caches, causing "buffer I/O error" and "device busy"
    #    errors when trying to close LUKS or format the device later.
    while true; do
        # Find the alphabetically last mount under /mnt to ensure nested mounts are 
        # unmounted before their parents (e.g., /mnt/proc/sys before /mnt/proc).
        m=$(awk '$3 ~ /^\/mnt\// {print $3}' /proc/mounts | sort -r | head -n 1)
        [ -z "$m" ] && break
        umount -f "$m" 2>/dev/null || break
    done

    # 3. Unmount /mnt itself
    umount -f /mnt 2>/dev/null || true

    # 4. Drop stray mapper mounts that might not be under /mnt
    while true; do
        m=$(awk '$1 ~ /^\/dev\/mapper\// {print $2}' /proc/mounts | sort -r | head -n 1)
        [ -z "$m" ] && break
        umount -f "$m" 2>/dev/null || break
    done

    # 5. Free the LUKS device cleanly. 
    # We do NOT use "dmsetup remove --force" as it forcefully detaches the device 
    # while the kernel still holds dirty caches, leading to future I/O errors!
    if cryptsetup status void_root >/dev/null 2>&1; then
        cryptsetup close void_root 2>/dev/null || true
    fi
    udevadm settle 2>/dev/null || true

    # 6. Drop a stale mapper node if the kernel mapping is really gone
    if [ -e /dev/mapper/void_root ] && ! dmsetup info void_root >/dev/null 2>&1; then
        rm -f /dev/mapper/void_root
    fi
}

drawDialog() {
    dialog --stdout --no-mouse \
           --backtitle "Koid Linux Installer" "$@"
}

drawDialogBack() {
    dialog --stdout --no-mouse --backtitle "Koid Linux Installer" --extra-button --extra-label "Back" "$@"
}

setKernelParam() {
    echo "$1" >> /mnt/etc/kernel/cmdline || die "Failed to set kernel parameter."
    kernelparam_update="true"
    return 0
}

enableService() {
    for service in "$@"; do
        system "ln -sf /etc/sv/$service /var/service"
    done
    return 0
}
