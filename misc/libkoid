#!/bin/sh
# void-install-script general library

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# --- 1. FILES AND DIALOG THEME SETUP ---
_KOID_MISC_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -f "${_KOID_MISC_DIR}/dialogrc" ]; then
    export DIALOGRC="${_KOID_MISC_DIR}/dialogrc"
fi
KOID_FILES_DIR=$(CDPATH= cd -- "${_KOID_MISC_DIR}/../files" && pwd)

# --- Kill leftovers from a previous chroot session ---
# Daemons started inside the chroot (dbus-daemon, snapperd, ...) keep their
# root/cwd inside /mnt. Lazy unmounts detach the mounts but the filesystem -
# and thus the LUKS container backing it - stays busy until they are gone.
kill_chroot_procs() {
    for pdir in /proc/[0-9]*; do
        pid=${pdir#/proc/}
        [ "$pid" = "$$" ] && continue
        proot=$(readlink "$pdir/root" 2>/dev/null) || continue
        case "$proot" in
            /mnt|/mnt/*) kill -9 "$pid" 2>/dev/null || true; continue ;;
        esac
        pcwd=$(readlink "$pdir/cwd" 2>/dev/null) || continue
        case "$pcwd" in
            /mnt|/mnt/*) kill -9 "$pid" 2>/dev/null || true ;;
        esac
    done
}

# --- Robust Cleanup Function ---
cleanup_mounts() {
    # Unmount chroot virtual filesystems
    for fs in proc sys dev/pts dev/shm dev run tmp; do
        if mountpoint -q "/mnt/$fs" 2>/dev/null; then
            umount -f -l "/mnt/$fs" 2>/dev/null
        fi
    done
    swapoff -a 2>/dev/null

    # Unmount anything backed by a device-mapper device, wherever it is mounted
    mapper_mounts=$(awk '$1 ~ /^\/dev\/mapper\// {print $2}' /proc/mounts | sort -r)
    for m in $mapper_mounts; do
        umount -f -l "$m" 2>/dev/null
    done

    # Unmount all mounted partitions inside /mnt in reverse order
    mounts=$(mount | awk '{print $3}' | grep '^/mnt/' | sort -r)
    for m in $mounts; do
        umount -f -l "$m" 2>/dev/null
    done

    # Unmount /mnt itself
    if mountpoint -q /mnt 2>/dev/null; then
        umount -f -l /mnt 2>/dev/null
    fi

    # Free the LUKS device: kill chroot leftovers, then close the container
    kill_chroot_procs
    if cryptsetup status void_root >/dev/null 2>&1; then
        cryptsetup close void_root 2>/dev/null || dmsetup remove --force void_root 2>/dev/null || true
    fi
    udevadm settle 2>/dev/null || true

    # Drop a stale mapper node if the kernel mapping is really gone
    if [ -e /dev/mapper/void_root ] && ! dmsetup info void_root >/dev/null 2>&1; then
        rm -f /dev/mapper/void_root
    fi
}

# --- Improved Error Handler ---
die() {
    msg="${1:-$commandFailure}"

    tput reset 2>/dev/null || clear

    # Restore kernel logging if modified
    if [ -w /proc/sys/kernel/printk ]; then
        echo 4 > /proc/sys/kernel/printk
    fi

    printf "\n%bINSTALLATION ABORTED%b\n" "$RED" "$NC"
    printf "%bReason: %s%b\n\n" "$RED" "$msg" "$NC"
    printf "Attempting to cleanly unmount partitions...\n"

    cleanup_mounts
    printf "\nYou may now safely exit or reboot.\n"
    exit 1
}

drawDialog() {
    dialog --stdout --no-mouse \
           --backtitle "Koid Linux Installer" "$@"
}

drawDialogBack() {
    dialog --stdout --no-mouse --backtitle "Koid Linux Installer" --extra-button --extra-label "Back" "$@"
}

install() {
    xbps-install -Sy -R "$repository" -r /mnt "$@" || die "Failed to install package(s): $*"
}

system() {
    chroot /mnt /bin/sh -c "$@" || die "Chroot command failed: $*"
}

setKernelParam() {
    echo "$1" >> /mnt/etc/kernel/cmdline || die "Failed to set kernel parameter."
    kernelparam_update="true"
    return 0
}

enableService() {
    for service in "$@"; do
        system "ln -sf /etc/sv/$service /var/service"
    done
    return 0
}
