#!/bin/bash
# void-install-script general library

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'
BOLD=${BOLD:-'\033[1m'}
CYAN=${CYAN:-'\033[0;36m'}

# ------------------------------------------------------------
# ASCII box drawing
# ------------------------------------------------------------
_koid_box() {
    local title="$1" color="$2"
    shift 2

    local lines=("$@")
    local wrapped=()
    local line l

    if [ ${#lines[@]} -eq 0 ]; then
        lines=(" ")
    fi

    # Wrap long lines nicely if fmt exists
    for line in "${lines[@]}"; do
        if command -v fmt >/dev/null 2>&1; then
            while IFS= read -r l; do
                wrapped+=("$l")
            done < <(printf '%s\n' "$line" | fmt -w 62)
        else
            wrapped+=("$line")
        fi
    done

    local width=${#title}
    for line in "${wrapped[@]}"; do
        (( ${#line} > width )) && width=${#line}
    done

    (( width < 26 )) && width=26

    local border="+"
    local i
    for ((i = 0; i < width + 2; i++)); do
        border+="-"
    done
    border+="+"

    printf '%b%s%b\n' "$color$BOLD" "$border" "$NC"
    printf '%b| %-*s |%b\n' "$color$BOLD" "$width" "$title" "$NC"
    printf '%b%s%b\n' "$color$BOLD" "$border" "$NC"

    for line in "${wrapped[@]}"; do
        printf '%b| %-*s |%b\n' "$color" "$width" "$line" "$NC"
    done

    printf '%b%s%b\n' "$color$BOLD" "$border" "$NC"
}

print_info_box() {
    local title="${1:-INFO}"
    shift 2>/dev/null || true
    _koid_box "$title" "$CYAN" "$@"
}

print_ok_box() {
    local title="${1:-OK}"
    shift 2>/dev/null || true
    _koid_box "$title" "$GREEN" "$@"
}

print_warn_box() {
    local title="${1:-WARNING}"
    shift 2>/dev/null || true
    _koid_box "$title" "$YELLOW" "$@"
}

print_error_box() {
    local title="${1:-ERROR}"
    shift 2>/dev/null || true
    _koid_box "$title" "$RED" "$@"
}

# --- FILES AND DIALOG THEME SETUP ---
_KOID_MISC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
if [ -f "${_KOID_MISC_DIR}/dialogrc" ]; then
    export DIALOGRC="${_KOID_MISC_DIR}/dialogrc"
fi
KOID_FILES_DIR="$(cd "${_KOID_MISC_DIR}/../files" &>/dev/null && pwd)"

# --- Robust Cleanup Function ---
cleanup_mounts() {
    # Unmount chroot virtual filesystems
    for fs in proc sys dev/pts dev/shm dev run tmp; do
        if mountpoint -q "/mnt/$fs" 2>/dev/null; then
            umount -f "/mnt/$fs" 2>/dev/null
        fi
    done
    swapoff -a 2>/dev/null
    
    # Unmount all mounted partitions inside /mnt in reverse order
    local mounts=$(mount | awk '{print $3}' | grep '^/mnt/' | sort -r)
    for m in $mounts; do
        umount -f "$m" 2>/dev/null
    done
    
    # Unmount /mnt itself
    if mountpoint -q /mnt 2>/dev/null; then
        umount -f /mnt 2>/dev/null
    fi
}

# --- Improved Error Handler ---
die() {
    local msg="${1:-$commandFailure}"
    
    tput reset 2>/dev/null || clear
    
    # Restore kernel logging if modified
    if [ -w /proc/sys/kernel/printk ]; then
        echo 4 > /proc/sys/kernel/printk
    fi
    
    echo -e "\n${RED}INSTALLATION ABORTED${NC}"
    echo -e "${RED}Reason: $msg${NC}\n"
    echo -e "Attempting to cleanly unmount partitions..."
    
    cleanup_mounts
    echo -e "\nYou may now safely exit or reboot."
    exit 1
}

drawDialog() {
    dialog --stdout --no-mouse \
           --backtitle "Koid Linux Installer" "$@"
}

drawDialogBack() {
    dialog --stdout --no-mouse --backtitle "Koid Linux Installer" --extra-button --extra-label "Back" "$@"
}

install() {
    xbps-install -Sy -R "$repository" -r /mnt "$@" || die "Failed to install package(s): $*"
}

system() {
    chroot /mnt /bin/bash -c "$@" || die "Chroot command failed: $*"
}

setKernelParam() {
    echo "$1" >> /mnt/etc/kernel/cmdline || die "Failed to set kernel parameter."
    kernelparam_update="true"
    return 0
}

enableService() {
    for service in "$@"; do
        system "ln -sf /etc/sv/$service /var/service"
    done
    return 0
}
