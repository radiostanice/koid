#!/bin/bash
# void-install-script general library

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# --- 1. FILES AND DIALOG THEME SETUP ---
_VISS_MISC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
if [ -f "${_VISS_MISC_DIR}/dialogrc" ]; then
    export DIALOGRC="${_VISS_MISC_DIR}/dialogrc"
fi

VISS_FILES_DIR="$(cd "${_VISS_MISC_DIR}/../files" &>/dev/null && pwd)"

# --- Robust Cleanup Function ---
cleanup_mounts() {
    # Unmount chroot virtual filesystems
    for fs in proc sys dev/pts dev/shm dev run tmp; do
        if mountpoint -q "/mnt/$fs" 2>/dev/null; then
            umount -f "/mnt/$fs" 2>/dev/null
        fi
    done
    swapoff -a 2>/dev/null
    
    # Unmount all mounted partitions inside /mnt in reverse order
    local mounts=$(mount | awk '{print $3}' | grep '^/mnt/' | sort -r)
    for m in $mounts; do
        umount -f "$m" 2>/dev/null
    done
    
    # Unmount /mnt itself
    if mountpoint -q /mnt 2>/dev/null; then
        umount -f /mnt 2>/dev/null
    fi
}

# --- Improved Error Handler ---
die() {
    local msg="${1:-$commandFailure}"
    
    tput reset 2>/dev/null || clear
    
    # Restore kernel logging if modified
    if [ -w /proc/sys/kernel/printk ]; then
        echo 4 > /proc/sys/kernel/printk
    fi
    
    echo -e "\n${RED}INSTALLATION ABORTED${NC}"
    echo -e "${RED}Reason: $msg${NC}\n"
    echo -e "Attempting to cleanly unmount partitions..."
    
    cleanup_mounts
    echo -e "\nYou may now safely exit or reboot."
    exit 1
}

drawDialog() {
    dialog --stdout --no-mouse \
           --backtitle "Void Linux Custom Installer" "$@"
}

drawDialogBack() {
    dialog --stdout --no-mouse --backtitle "Void Linux Custom Installer" --extra-button --extra-label "Back" "$@"
}

install() {
    local attempt=1 attempts=10 delay=5 rc
    
    while :; do
        # 1. FAST NETWORK CHECK (Timeout: 10 seconds)
        # We only use 'timeout' for the index sync (-S). This prevents the 60-second 
        # freeze if the network is completely dead.
        CONNECTION_TIMEOUT=10000 timeout -k 5 10 xbps-install -S -R "$repository" -r /mnt >/dev/null 2>&1
        if [ $? -ne 0 ]; then
            echo -e "${YELLOW}Repository index sync failed. Network might be down.${NC}"
            rc=1
        else
            # 2. MAIN PACKAGE INSTALLATION (No blind timeout!)
            # We do not use 'timeout' here. Large packages take time to download; 
            # wrapping them in timeout would kill healthy slow downloads.
            CONNECTION_TIMEOUT=300000 xbps-install -y -R "$repository" -r /mnt "$@"
            rc=$?
            
            # Success: exit the loop
            [ $rc -eq 0 ] && return 0
            
            echo -e "${YELLOW}Package installation failed on attempt $attempt/$attempts.${NC}"
        fi
        
        # Failure: check if we've exhausted retries
        if [ "$attempt" -ge "$attempts" ]; then
            die "Failed to install package(s): $* (after $attempts attempts)"
        fi
        
        echo -e "${YELLOW}Pausing for ${delay} seconds to let the connection stabilize...${NC}"
        sleep "$delay"
        
        # 3. SMART WAIT: Wait until the network ACTUALLY responds before retrying.
        # We use xbps-fetch to test the repository URL directly. This prevents the 
        # "instant retry spam" because it won't proceed until the repo is reachable.
        local net_ok=0
        while [ $net_ok -eq 0 ]; do
            if CONNECTION_TIMEOUT=5000 xbps-fetch -o /dev/null "$repository" >/dev/null 2>&1; then
                net_ok=1
                echo -e "${GREEN}Network connectivity restored! Retrying immediately...${NC}"
            else
                echo -e "${YELLOW}Network still unreachable, waiting 5 more seconds...${NC}"
                sleep 5
            fi
        done
        
        attempt=$((attempt + 1))
        # Exponential backoff for the initial delay, capped at 60 seconds
        delay=$(( delay * 2 > 60 ? 60 : delay * 2 ))
    done
}

system() {
    chroot /mnt /bin/bash -c "$@" || die "Chroot command failed: $*"
}

setKernelParam() {
    echo "$1" >> /mnt/etc/kernel/cmdline || die "Failed to set kernel parameter."
    kernelparam_update="true"
    return 0
}

enableService() {
    for service in "$@"; do
        system "ln -sf /etc/sv/$service /var/service"
    done
    return 0
}
