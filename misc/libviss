#!/bin/bash
# void-install-script general library

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# --- 1. FILES AND DIALOG THEME SETUP ---
_VISS_MISC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
if [ -f "${_VISS_MISC_DIR}/dialogrc" ]; then
    export DIALOGRC="${_VISS_MISC_DIR}/dialogrc"
fi

VISS_FILES_DIR="$(cd "${_VISS_MISC_DIR}/../files" &>/dev/null && pwd)"

# --- Robust Cleanup Function ---
cleanup_mounts() {
    # Unmount chroot virtual filesystems
    for fs in proc sys dev/pts dev/shm dev run tmp; do
        if mountpoint -q "/mnt/$fs" 2>/dev/null; then
            umount -f "/mnt/$fs" 2>/dev/null
        fi
    done
    swapoff -a 2>/dev/null
    
    # Unmount all mounted partitions inside /mnt in reverse order
    local mounts=$(mount | awk '{print $3}' | grep '^/mnt/' | sort -r)
    for m in $mounts; do
        umount -f "$m" 2>/dev/null
    done
    
    # Unmount /mnt itself
    if mountpoint -q /mnt 2>/dev/null; then
        umount -f /mnt 2>/dev/null
    fi
}

# --- Improved Error Handler ---
die() {
    local msg="${1:-$commandFailure}"
    
    tput reset 2>/dev/null || clear
    
    # Restore kernel logging if modified
    if [ -w /proc/sys/kernel/printk ]; then
        echo 4 > /proc/sys/kernel/printk
    fi
    
    echo -e "\n${RED}INSTALLATION ABORTED${NC}"
    echo -e "${RED}Reason: $msg${NC}\n"
    echo -e "Attempting to cleanly unmount partitions..."
    
    cleanup_mounts
    echo -e "\nYou may now safely exit or reboot."
    exit 1
}

drawDialog() {
    dialog --stdout --no-mouse \
           --backtitle "Void Linux Custom Installer" "$@"
}

drawDialogBack() {
    dialog --stdout --no-mouse --backtitle "Void Linux Custom Installer" --extra-button --extra-label "Back" "$@"
}

install() {
    local attempt=1 attempts=10 delay=5 rc
    
    while :; do
        echo -e "${YELLOW}Starting installation attempt $attempt/$attempts...${NC}"
        
        # Run xbps-install in the background so we can monitor its health
        CONNECTION_TIMEOUT=300000 xbps-install -y -R "$repository" -r /mnt "$@" > /tmp/xbps_install.log 2>&1 &
        local xbps_pid=$!
        
        local stall_seconds=0
        local last_cache_size=$(du -sk /mnt/var/cache/xbps/ 2>/dev/null | awk '{print $1}' || echo 0)
        local last_cpu_ticks=$(awk '{print $14+$15}' /proc/$xbps_pid/stat 2>/dev/null || echo 0)
        local dead=0
        
        # Monitor loop: check every 5 seconds
        while kill -0 $xbps_pid 2>/dev/null; do
            sleep 5
            
            # If process finished, break
            if ! kill -0 $xbps_pid 2>/dev/null; then
                break
            fi
            
            local current_cache_size=$(du -sk /mnt/var/cache/xbps/ 2>/dev/null | awk '{print $1}' || echo 0)
            local current_cpu_ticks=$(awk '{print $14+$15}' /proc/$xbps_pid/stat 2>/dev/null || echo 0)
            
            # If EITHER cache is growing (downloading) OR CPU is working (configuring), it's healthy!
            if [ "$current_cache_size" -gt "$last_cache_size" ] || [ "$current_cpu_ticks" -gt "$last_cpu_ticks" ]; then
                last_cache_size=$current_cache_size
                last_cpu_ticks=$current_cpu_ticks
                stall_seconds=0
            else
                # No progress and no CPU activity -> likely blocked on a dead socket
                stall_seconds=$((stall_seconds + 5))
                if [ "$stall_seconds" -ge 30 ]; then
                    echo -e "${RED}Process stalled for 30 seconds (likely dead network). Killing...${NC}"
                    kill -9 $xbps_pid 2>/dev/null
                    wait $xbps_pid 2>/dev/null
                    dead=1
                    break
                fi
            fi
        done
        
        # Reap the exit code
        wait $xbps_pid 2>/dev/null
        rc=$?
        
        # If we killed it due to stall, force failure
        [ "$dead" -eq 1 ] && rc=1
        
        # Success
        [ $rc -eq 0 ] && return 0
        
        # Failure: check if we've exhausted retries
        if [ "$attempt" -ge "$attempts" ]; then
            die "Failed to install package(s): $* (after $attempts attempts)"
        fi
        
        echo -e "${YELLOW}Network issue detected. Pausing for ${delay} seconds...${NC}"
        sleep "$delay"
        
        # Smart Wait: Wait until the network ACTUALLY responds before retrying.
        local net_ok=0
        while [ $net_ok -eq 0 ]; do
            if CONNECTION_TIMEOUT=5000 xbps-fetch -o /dev/null "$repository" >/dev/null 2>&1; then
                net_ok=1
                echo -e "${GREEN}Network connectivity restored! Retrying immediately...${NC}"
            else
                echo -e "${YELLOW}Network still unreachable, waiting 5 more seconds...${NC}"
                sleep 5
            fi
        done
        
        attempt=$((attempt + 1))
        # Exponential backoff, capped at 60 seconds
        delay=$(( delay * 2 > 60 ? 60 : delay * 2 ))
    done
}

system() {
    chroot /mnt /bin/bash -c "$@" || die "Chroot command failed: $*"
}

setKernelParam() {
    echo "$1" >> /mnt/etc/kernel/cmdline || die "Failed to set kernel parameter."
    kernelparam_update="true"
    return 0
}

enableService() {
    for service in "$@"; do
        system "ln -sf /etc/sv/$service /var/service"
    done
    return 0
}
