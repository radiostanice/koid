#!/bin/bash
# Basic checks and setup before the installer reaches configuration

echo "Running basic checks..."

if [ "$(id -u)" -ne 0 ]; then
    echo -e "${RED}Please execute this script as root.${NC}"
    exit 1
fi

dependencies=("setup/base" "setup/desktop" "setup/disk" "setup/chroot" "misc/60-ukify" "misc/libkoid")

for i in "${dependencies[@]}"; do
    [ -e "$i" ] ||
        { commandFailure="$i appears to be missing. This could be because it is incorrectly named, or it does not exist." ; die ; }
    bash -n "$i" 2>/dev/null ||
        { commandFailure="Syntax error in $i (e.g. unclosed quote). Run 'bash -n $i' to find the exact line." ; die ; }
done

[ -e "/sys/firmware/efi" ] ||
    { commandFailure="This script only supports UEFI systems, but it appears we have booted as BIOS." ; die ; }

[ "$(uname -m)" != "x86_64" ] &&
    { commandFailure="This systems CPU architecture is not currently supported by this installer." ; die ; }

echo "Finding out what libc is being used..."
if ldd --version 2>&1 | grep -q GNU ; then
    libc="glibc"
else
    libc="musl"
fi

echo "Testing for network connectivity..."
if ! xbps-install -S > /dev/null 2>&1; then
    # 1. Detect available wireless interfaces using `ip a`
    wifi_interfaces=()
    while read -r line; do
        if [[ "$line" =~ ^[0-9]+: ]]; then
            iface=$(echo "$line" | awk -F': ' '{print $2}' | cut -d'@' -f1)
            # Check if it's a wireless interface by looking for phy80211 or wireless sysfs dirs
            if [ -d "/sys/class/net/$iface/phy80211" ] || [ -d "/sys/class/net/$iface/wireless" ]; then
                wifi_interfaces+=("$iface" "Wireless Interface")
            fi
        fi
    done < <(ip a)

    if [ ${#wifi_interfaces[@]} -eq 0 ]; then
        drawDialog --msgbox "No wireless interfaces found.\nPlease connect an Ethernet cable to continue." 0 0
        commandFailure="Network check failed: Cannot synchronize Void repositories and no Wi-Fi available."
        die
    fi

    # 2. Prompt user to select interface, SSID, and password
    wifi_iface=$(drawDialog --stdout --no-mouse --backtitle "Koid Linux Installer" --no-cancel --title "Network Setup" --menu "No internet connection detected.\nSelect a Wi-Fi interface to connect:" 0 0 0 "${wifi_interfaces[@]}")
    if [ -z "$wifi_iface" ]; then
        commandFailure="Network check failed: Cannot synchronize Void repositories."
        die
    fi

    wifi_ssid=$(drawDialog --stdout --no-mouse --backtitle "Koid Linux Installer" --no-cancel --title "Wi-Fi Setup" --inputbox "Enter Wi-Fi SSID (Network Name):" 0 0)
    if [ -z "$wifi_ssid" ]; then
        commandFailure="Network check failed: Cannot synchronize Void repositories."
        die
    fi

    wifi_pass=$(drawDialog --stdout --no-mouse --backtitle "Koid Linux Installer" --no-cancel --title "Wi-Fi Setup" --passwordbox "Enter Wi-Fi Password for $wifi_ssid:" 0 0)

    conf_file="/etc/wpa_supplicant/wpa_supplicant-${wifi_iface}.conf"
    mkdir -p /etc/wpa_supplicant
    
    # Kill any existing wpa_supplicant on this interface to prevent conflicts
    wpa_cli -i "$wifi_iface" terminate >/dev/null 2>&1 || true
    
    # 3. Generate wpa_supplicant configuration
    if [ -z "$wifi_pass" ]; then
        # Handle open networks with no password
        cat <<EOF > "$conf_file"
network={
    ssid="$wifi_ssid"
    key_mgmt=NONE
}
EOF
    else
        # Note: Using > instead of >> prevents duplicate network blocks if the user retries
        wpa_passphrase "$wifi_ssid" "$wifi_pass" > "$conf_file"
    fi

    # 4. Connect to Wi-Fi
    drawDialog --infobox "Connecting to Wi-Fi..." 3 30
    wpa_supplicant -B -i "$wifi_iface" -Dnl80211 -c "$conf_file" >/dev/null 2>&1
    sleep 3
    
    # 5. Obtain an IP address via DHCP
    if command -v dhcpcd >/dev/null 2>&1; then
        dhcpcd "$wifi_iface" >/dev/null 2>&1 &
    elif command -v dhclient >/dev/null 2>&1; then
        dhclient "$wifi_iface" >/dev/null 2>&1 &
    fi
    sleep 4

    # 6. Retry the network check
    echo "Retesting network connectivity..."
    if ! xbps-install -S > /dev/null 2>&1; then
        commandFailure="Network check failed: Could not connect to Wi-Fi or synchronize Void repositories."
        die
    fi
fi

commandFailure="Dependency installation has failed."
xbps-install -Suy xbps || die
xbps-install -Suy dialog || die

dialog --create-rc "$HOME/.dialogrc"

logFile="/tmp/koid-install.log"

return 0
