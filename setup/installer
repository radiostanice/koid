#!/bin/bash
# Basic checks and setup before the installer reaches configuration

echo "Running basic checks..."

if [ "$(id -u)" -ne 0 ]; then
    echo -e "${RED}Please execute this script as root.${NC}"
    exit 1
fi

dependencies=("setup/base" "setup/desktop" "setup/disk" "setup/chroot" "misc/60-ukify" "misc/libkoid")

for i in "${dependencies[@]}"; do
    [ -e "$i" ] ||
        { commandFailure="$i appears to be missing. This could be because it is incorrectly named, or it does not exist." ; die ; }
    bash -n "$i" 2>/dev/null ||
        { commandFailure="Syntax error in $i (e.g. unclosed quote). Run 'bash -n $i' to find the exact line." ; die ; }
done

[ -e "/sys/firmware/efi" ] ||
    { commandFailure="This script only supports UEFI systems, but it appears we have booted as BIOS." ; die ; }

[ "$(uname -m)" != "x86_64" ] &&
    { commandFailure="This systems CPU architecture is not currently supported by this installer." ; die ; }

echo "Finding out what libc is being used..."
if ldd --version 2>&1 | grep -q GNU ; then
    libc="glibc"
else
    libc="musl"
fi

# --- Network Connectivity & Wi-Fi Setup ---
echo "Testing for network connectivity..."

check_internet() {
    if command -v ping >/dev/null 2>&1; then
        if ping -c 1 -W 3 1.1.1.1 >/dev/null 2>&1; then return 0; fi
        if ping -c 1 -W 3 repo-default.voidlinux.org >/dev/null 2>&1; then return 0; fi
    fi
    if command -v wget >/dev/null 2>&1; then
        if wget -q --spider --timeout=3 http://repo-default.voidlinux.org >/dev/null 2>&1; then return 0; fi
    fi
    if command -v curl >/dev/null 2>&1; then
        if curl -s --max-time 3 -I http://repo-default.voidlinux.org >/dev/null 2>&1; then return 0; fi
    fi
    return 1
}

if ! check_internet; then
    # Check if dialog is available, otherwise fallback to terminal prompts
    if command -v dialog >/dev/null 2>&1; then
        drawDialog --infobox "No internet connection detected.\nScanning for wireless interfaces..." 3 40
        USE_DIALOG=1
    else
        echo -e "\n\033[1;33m[!] No internet connection detected.\033[0m"
        USE_DIALOG=0
    fi
    
    # 1. Detect wireless interfaces
    wifi_interfaces=()
    while read -r line; do
        if [[ "$line" =~ ^[0-9]+: ]]; then
            iface=$(echo "$line" | awk -F': ' '{print $2}' | cut -d'@' -f1)
            if [ -d "/sys/class/net/$iface/phy80211" ] || [ -d "/sys/class/net/$iface/wireless" ] || [[ "$iface" =~ ^wl ]]; then
                wifi_interfaces+=("$iface" "Wireless Interface")
            fi
        fi
    done < <(ip a)

    if [ ${#wifi_interfaces[@]} -eq 0 ]; then
        if [ "$USE_DIALOG" -eq 1 ]; then
            drawDialog --msgbox "No wireless interfaces found.\nPlease connect an Ethernet cable and restart." 0 0
        else
            echo "No wireless interfaces found. Please connect an Ethernet cable and restart."
        fi
        commandFailure="Network check failed: No internet and no Wi-Fi interface found."
        die
    fi

    # 2. Prompt for Interface, SSID, and Password
    if [ "$USE_DIALOG" -eq 1 ]; then
        wifi_iface=$(drawDialog --stdout --no-mouse --backtitle "Koid Linux Installer" --no-cancel --title "Wi-Fi Setup" --menu "Select a wireless interface:" 0 0 0 "${wifi_interfaces[@]}")
        if [ -z "$wifi_iface" ]; then commandFailure="Wi-Fi setup cancelled."; die; fi

        wifi_ssid=$(drawDialog --stdout --no-mouse --backtitle "Koid Linux Installer" --no-cancel --title "Wi-Fi Setup" --inputbox "Enter Wi-Fi SSID (Network Name):" 0 0)
        if [ -z "$wifi_ssid" ]; then commandFailure="Wi-Fi setup cancelled."; die; fi

        wifi_pass=$(drawDialog --stdout --no-mouse --backtitle "Koid Linux Installer" --no-cancel --title "Wi-Fi Setup" --passwordbox "Enter Wi-Fi Password for $wifi_ssid:" 0 0)
    else
        echo "Available wireless interfaces:"
        for ((i=0; i<${#wifi_interfaces[@]}; i+=2)); do
            echo "  $((i/2 + 1))) ${wifi_interfaces[i]}"
        done
        read -p "Select interface number: " iface_num
        wifi_iface="${wifi_interfaces[$(( (iface_num - 1) * 2 ))]}"
        if [ -z "$wifi_iface" ]; then commandFailure="Wi-Fi setup cancelled."; die; fi

        read -p "Enter Wi-Fi SSID: " wifi_ssid
        if [ -z "$wifi_ssid" ]; then commandFailure="Wi-Fi setup cancelled."; die; fi

        read -s -p "Enter Wi-Fi Password: " wifi_pass
        echo ""
    fi

    # 3. Setup wpa_supplicant
    conf_file="/etc/wpa_supplicant/wpa_supplicant-${wifi_iface}.conf"
    mkdir -p /etc/wpa_supplicant
    
    wpa_cli -i "$wifi_iface" terminate >/dev/null 2>&1 || true

    if [ -z "$wifi_pass" ]; then
        cat <<EOF > "$conf_file"
network={
    ssid="$wifi_ssid"
    key_mgmt=NONE
}
EOF
    else
        # Using > instead of >> to prevent appending duplicate blocks if the user retries
        wpa_passphrase "$wifi_ssid" "$wifi_pass" > "$conf_file"
    fi

    if [ "$USE_DIALOG" -eq 1 ]; then
        drawDialog --infobox "Connecting to $wifi_ssid..." 3 30
    else
        echo "Connecting to $wifi_ssid..."
    fi
    
    ip link set "$wifi_iface" up >/dev/null 2>&1
    wpa_supplicant -B -i "$wifi_iface" -Dnl80211 -c "$conf_file" >/dev/null 2>&1
    sleep 3
    
    # 4. Obtain IP Address
    if command -v dhcpcd >/dev/null 2>&1; then
        dhcpcd "$wifi_iface" >/dev/null 2>&1 &
    elif command -v dhclient >/dev/null 2>&1; then
        dhclient "$wifi_iface" >/dev/null 2>&1 &
    fi
    sleep 4

    # 5. Verify connection
    if ! check_internet; then
        if [ "$USE_DIALOG" -eq 1 ]; then
            drawDialog --msgbox "Failed to connect to Wi-Fi or obtain IP address.\nPlease check your SSID/Password and try again." 0 0
        else
            echo "Failed to connect to Wi-Fi. Please check SSID/Password."
        fi
        commandFailure="Network check failed: Could not connect to Wi-Fi."
        die
    fi
fi

# Now that we have internet, sync repos
echo "Synchronizing repositories..."
if ! xbps-install -S > /dev/null 2>&1; then
    commandFailure="Network check failed: Cannot synchronize Void repositories."
    die
fi

commandFailure="Dependency installation has failed."
xbps-install -Suy xbps || die
xbps-install -Suy dialog || die

dialog --create-rc "$HOME/.dialogrc"
logFile="/tmp/koid-install.log"

return 0
