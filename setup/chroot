#!/bin/bash

. "/tmp/libkoid" || { echo "/tmp/libkoid not found."; exit 1; }
. "/tmp/installerOptions" || { commandFailure="Sourcing installer options failed."; die; }

exitFunction () {
    xbps-reconfigure -fa || { commandFailure="xbps-reconfigure failed."; die; }

    # Remove unused TTYs (3-6) 
    for service in agetty-tty{3..6}; do
        rm -f /etc/runit/runsvdir/default/"$service"
    done

    # --- SECURE DNS: ownership + DNSSEC root key ---
    if command -v unbound-anchor >/dev/null 2>&1; then
        chown -R _unbound:_unbound /etc/unbound /var/lib/unbound || true
        unbound-anchor -a "/var/lib/unbound/root.key" || true
        chown _unbound:_unbound /var/lib/unbound/root.key || true
    fi

    rm -f /var/log/xbps.log
    rm -rf /tmp/files /tmp/libkoid /tmp/chroot /tmp/60-ukify /tmp/installerOptions

    # SAFETY ADDITION: Force the new "Void Linux" entry to the top of the UEFI boot order.
    if [ -n "$newEntry" ]; then
        commandFailure="Setting default boot entry has failed."
        rest=$(efibootmgr | sed -n 's/^BootOrder: //p' | tr ',' '\n' | grep -vx "$newEntry" | paste -sd ',' -)
        efibootmgr -o "${newEntry}${rest:+,$rest}" || die
    fi
    exit 0
}

userPassword() {
    status "Setting password for user $username..." "$CYAN"
    trap 'commandFailure="Password setup cancelled by user."; exitFunction' INT
    while ! passwd "$username"; do :; done
    trap - INT
    status "Password set for $username" "$GREEN"
}

rootPassword() {
    status "Setting root password..." "$CYAN"
    trap 'commandFailure="Password setup cancelled by user."; exitFunction' INT
    while ! passwd root; do :; done
    trap - INT
    status "Root password set" "$GREEN"
    [ -n "$username" ] && userPassword
    exitFunction
}

chown root:root / || die
chmod 755 / || die
chmod 0700 /root || die 
[ -e /etc/sv/dbus ] && { ln -s /etc/sv/dbus /var/service || die ; }

# --- SECURE BOOT SETUP ---
if [ "$secureboot" = "Yes" ]; then
    status "Setting up Secure Boot with sbctl..."
    xbps-install -y sbctl || die "Failed to install sbctl."

    if [ ! -f /var/lib/sbctl/keys/db/db.key ]; then
        sbctl create-keys || die "Failed to create Secure Boot keys."
        status "Secure Boot keys generated. You MUST enroll them in your BIOS/UEFI on first boot!" "$YELLOW"
    fi

    # Create the kernel hook for automatic signing (Atomic install)
    /usr/bin/install -Dm755 /tmp/files/70-sbctl-sign /etc/kernel.d/post-install/70-sbctl-sign || die "Failed to install sbctl signing hook."
fi

# --- UKI GENERATION ---
commandFailure="UKI generation has failed."
mkdir -p /boot/efi/EFI/Linux || die

# Copy the ukify hook into place (Atomic install)
/usr/bin/install -Dm755 /tmp/60-ukify /etc/kernel.d/post-install/60-ukify || die

kernel_pkg=$(xbps-query -l | awk '$1 == "ii" && $2 ~ /^linux[0-9]+\.[0-9]+-/ {print $2}' | sed 's/-[0-9].*//' | head -n 1)
status "Detected kernel package: $kernel_pkg"
if [ -z "$kernel_pkg" ]; then
    commandFailure="Could not detect installed kernel package."
    die
fi

rm -f /boot/initramfs-*.img
xbps-reconfigure -f "$kernel_pkg" || die

if [ ! -f "/boot/efi/EFI/Linux/void-linux.efi" ]; then
    status "No UKI after targeted reconfigure, falling back to xbps-reconfigure -fa"
    xbps-reconfigure -fa || die
fi

if [ "$secureboot" = "Yes" ]; then
    commandFailure="UKI is not signed with sbctl keys."
    sbctl verify /boot/efi/EFI/Linux/void-linux.efi || die
fi

img=$(ls /boot/initramfs-*.img 2>/dev/null | head -n1)
[ -n "$img" ] || { commandFailure="No initramfs was generated by booster."; die; }
img_size=$(stat -c%s "$img" 2>/dev/null)
[ "$img_size" -gt 1000000 ] || { commandFailure="$img is too small, likely not generated properly by booster."; die; }

# --- UKI NVRAM REGISTRATION ---
efi_label="Void Linux"
efi_stub="/boot/efi/EFI/Linux/void-linux.efi"
[ -f "$efi_stub" ] || die "UKI stub not found at $efi_stub."

for n in $(efibootmgr -v | grep -F "$efi_label" | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)[* ].*/\1/p'); do
    status "Purging stale UEFI boot entry Boot$n"
    efibootmgr -b "$n" -B >/dev/null 2>&1 || true
done

efibootmgr --create --label "$efi_label" --disk "$diskInput" --part 1 \
    --loader '\EFI\Linux\void-linux.efi' || die "efibootmgr --create failed."

newEntry=$(efibootmgr -v | grep -F "$efi_label" | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)[* ].*/\1/p' | head -n1)
[ -n "$newEntry" ] || die "Could not find the newly created UEFI boot entry for '${efi_label}'."
status "Registered UEFI boot entry Boot${newEntry}"

commandFailure="Post-installation configuration failed (after NVRAM registration)."
ln -sf /usr/share/zoneinfo/"$timezone" /etc/localtime || die

# --- APPLY SYSCTL CONFIGURATION ---
status "Applying sysctl kernel parameters..."
sysctl --system || true

sys_locale="${locale#LANG=}"
[ -z "$sys_locale" ] && sys_locale="en_US.UTF-8"

# =========================================================================
# SYSTEM-WIDE HARDENING & DNS RESTORATION
# =========================================================================

status "Restoring hardened DNS configuration..."
cp /tmp/files/resolv.conf /etc/resolv.conf || die
chown root:root /etc/resolv.conf || die

# --- SECURE IMPORTANT SYSTEM FILES ---
status "Locking down critical system files (chattr +i)..."
commandFailure="Securing system files with chmod/chattr has failed."

chmod 0400 /etc/doas.conf || die
chmod 0644 /etc/fstab /etc/hostname /etc/locale.conf /etc/resolv.conf \
           /etc/chrony.conf /etc/unbound/unbound.conf \
           /etc/NetworkManager/conf.d/00-nm-setup.conf /etc/nftables.conf \
           /etc/sysctl.d/99-sysctl.conf /etc/security/limits.d/99-disable-coredump.conf \
           /etc/modprobe.d/99-blacklist.conf || true

chattr +i /etc/nftables.conf /etc/doas.conf /etc/chrony.conf \
          /etc/unbound/unbound.conf /etc/NetworkManager/conf.d/00-nm-setup.conf \
          /etc/sysctl.d/99-sysctl.conf /etc/security/limits.d/99-disable-coredump.conf \
          /etc/modprobe.d/99-blacklist.conf || die

# =========================================================================
# USER CREATION & CONFIGURATION
# =========================================================================

useradd "$username" -m -d /home/"$username" || die
if echo "$extra_packages" | grep -qw "virt-manager"; then
    usermod -aG audio,video,kvm,wheel,libvirt "$username" || die
else
    usermod -aG audio,video,kvm,wheel "$username" || die
fi

# Use /usr/bin/install to cleanly set ownership and permissions in one step
sed "s/@LOCALE@/${sys_locale}/g" /tmp/files/bashrc > /tmp/bashrc.tmp || die
/usr/bin/install -Dm644 -o "$username" -g "$username" /tmp/bashrc.tmp "/home/$username/.bashrc" || die
/usr/bin/install -Dm644 -o "$username" -g "$username" /tmp/files/bash_profile "/home/$username/.bash_profile" || die
rm -f /tmp/bashrc.tmp

# Lock user shell configs
chattr +i /home/"$username"/.bashrc /home/"$username"/.bash_profile || die

# --- TTY CONFIGURATION ---
sed "s|@USERNAME@|$username|g" /tmp/files/agetty-tty1.conf > /tmp/agetty-tty1.conf.tmp || die
/usr/bin/install -Dm644 /tmp/agetty-tty1.conf.tmp /etc/sv/agetty-tty1/conf || die
rm -f /tmp/agetty-tty1.conf.tmp

# --- KDE PLASMA HARDENED DEFAULTS ---
status "Applying KDE Plasma hardened defaults..."
commandFailure="Configuring KDE Plasma defaults has failed."
KDE_CONFIG_DIR="/home/$username/.config"

/usr/bin/install -d -m 0755 -o "$username" -g "$username" "$KDE_CONFIG_DIR" "$KDE_CONFIG_DIR/KDE"

# Now you can safely use install WITHOUT the -D flag (since dirs already exist)
for rc in ksplashrc baloofilerc krunnerrc ksmserverrc kwinrc kactivitymanagerd-pluginsrc; do
    /usr/bin/install -m644 -o "$username" -g "$username" "/tmp/files/kde/$rc" "$KDE_CONFIG_DIR/$rc" || die
done

# Sonnet spellcheck config
kde_lang="${sys_locale%%.*}"
[[ "$kde_lang" == "C" || "$kde_lang" == "POSIX" ]] && kde_lang="en_US"
sed "s|@LANG@|${kde_lang}|g" /tmp/files/kde/Sonnet.conf > /tmp/Sonnet.conf || die
/usr/bin/install -m644 -o "$username" -g "$username" /tmp/Sonnet.conf "$KDE_CONFIG_DIR/KDE/Sonnet.conf" || die
rm -f /tmp/Sonnet.conf

# ===================
# SUID/SGID HARDENING 
# ===================
status "Stripping legacy/unused SUID/SGID bits..."
commandFailure="SUID/SGID hardening has failed."

chmod g-s /usr/bin/write /usr/bin/wall 2>/dev/null || true
chmod u-s /usr/bin/chfn 2>/dev/null || true
chmod u-s /usr/bin/xbps-uchroot 2>/dev/null || true
chmod u-s /usr/bin/newgrp /usr/bin/sg 2>/dev/null || true
chmod u-s /usr/bin/gpasswd 2>/dev/null || true
chmod u-s /usr/bin/chage /usr/bin/expiry 2>/dev/null || true
chmod u-s /usr/bin/chsh 2>/dev/null || true
chmod u-s /usr/libexec/ssh-keysign 2>/dev/null || true

# --- FINALIZE ---
clear
rootPassword
