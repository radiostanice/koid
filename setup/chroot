#!/bin/sh

. "/tmp/libkoid" || { echo "/tmp/libkoid not found."; exit 1; }
. "/tmp/installerOptions" || { commandFailure="Sourcing installer options failed."; die; }

exitFunction () {
    xbps-reconfigure -fa || { commandFailure="xbps-reconfigure failed."; die; }

    # --- SECURE DNS: ownership + DNSSEC root key ---
    if command -v unbound-anchor >/dev/null 2>&1; then
        # Fix ownership now that we're inside the target rootfs
        chown -R _unbound:_unbound /etc/unbound /var/lib/unbound || true

        # Generate the DNSSEC trust anchor
        unbound-anchor -a "/var/lib/unbound/root.key" || true
        chown _unbound:_unbound /var/lib/unbound/root.key || true
    fi

    # Drop xbps/ukify log since it's unreadable on a failed boot anyway
    rm -f /var/log/xbps.log

    # Remove installer artifacts from the target system
    rm -rf /tmp/files /tmp/libkoid /tmp/chroot /tmp/60-ukify /tmp/installerOptions

    # SAFETY ADDITION: Force the new "Void Linux" entry to the top of the UEFI boot order.
    if [ -n "$newEntry" ]; then
        commandFailure="Setting default boot entry has failed."
        rest=$(efibootmgr | sed -n 's/^BootOrder: //p' | tr ',' '\n' | grep -vx "$newEntry" | paste -sd ',' -)
        efibootmgr --bootorder "${newEntry}${rest:+,$rest}" || die
    fi
    exit 0
}

userPassword() {
    printf "%bSet password for user %s: %b\n" "$YELLOW" "$username" "$NC"
    while ! passwd "$username"; do :; done
}

rootPassword() {
    printf "%bSet your root password: %b\n" "$YELLOW" "$NC"
    while ! passwd root; do :; done
    [ -n "$username" ] && userPassword
    exitFunction
}

chown root:root / || die
chmod 755 / || die
[ -e /etc/sv/dbus ] && { ln -s /etc/sv/dbus /var/service || die ; }

# --- SECURE BOOT SETUP ---
if [ "$secureboot" = "Yes" ]; then
    echo "Setting up Secure Boot with sbctl..."
    xbps-install -y sbctl || die "Failed to install sbctl."

    if [ ! -f /var/lib/sbctl/keys/db/db.key ]; then
        sbctl create-keys || die "Failed to create Secure Boot keys."
        printf "%bSecure Boot keys generated. You MUST enroll them in your BIOS/UEFI on first boot!%b\n" "$YELLOW" "$NC"
    fi

    # Create the kernel hook for automatic signing
    mkdir -p /etc/kernel.d/post-install
    cp /tmp/files/70-sbctl-sign /etc/kernel.d/post-install/70-sbctl-sign || die "Failed to install sbctl signing hook."
    chmod 755 /etc/kernel.d/post-install/70-sbctl-sign
fi

# --- UKI GENERATION ---
commandFailure="UKI generation has failed."

# Ensure the UKI output directory exists BEFORE reconfiguring kernel
mkdir -p /boot/efi/EFI/Linux || die

# Copy the ukify hook into place
cp /tmp/60-ukify /etc/kernel.d/post-install/60-ukify || die
chmod 755 /etc/kernel.d/post-install/60-ukify || die

# Dynamically find the installed kernel package
kernel_pkg=$(xbps-query -l | awk '$1 == "ii" && $2 ~ /^linux[0-9]+\.[0-9]+-/ {print $2}' | sed 's/-[0-9].*//' | head -n 1)
echo "Detected kernel package: $kernel_pkg"
if [ -z "$kernel_pkg" ]; then
    commandFailure="Could not detect installed kernel package."
    die
fi

# Kill stale initramfs from the OTHER generator so it isn't embedded into the UKI
rm -f /boot/initramfs-*.img

# Force kernel reconfiguration to trigger initramfs + UKI generation
xbps-reconfigure -f "$kernel_pkg" || die

# Belt and braces: if the targeted reconfigure produced no UKI, reconfigure everything
if [ ! -f "/boot/efi/EFI/Linux/void-linux.efi" ]; then
    echo "No UKI after targeted reconfigure, falling back to xbps-reconfigure -fa"
    xbps-reconfigure -fa || die
fi

if [ "$secureboot" = "Yes" ]; then
    commandFailure="UKI is not signed with sbctl keys."
    sbctl verify /boot/efi/EFI/Linux/void-linux.efi || die
fi

# Hard gates for initramfs generation to prevent silent dracut/tinyramfs mismatches
img=$(ls /boot/initramfs-*.img 2>/dev/null | head -n1)
[ -n "$img" ] || { commandFailure="No initramfs was generated by booster."; die; }

# Booster handles LUKS out-of-the-box via kernel cmdline and generates a compact image.
# Just verify the image was created and is reasonably sized (usually a few MBs).
img_size=$(wc -c < "$img")
[ "$img_size" -gt 1000000 ] || { commandFailure="$img is too small, likely not generated properly by booster."; die; }

# --- UKI NVRAM REGISTRATION ---
efi_label="Void Linux"
efi_stub="/boot/efi/EFI/Linux/void-linux.efi"
[ -f "$efi_stub" ] || die "UKI stub not found at $efi_stub."

# Purge stale entries from previous attempts
for n in $(efibootmgr -v | grep -F "$efi_label" | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)[* ].*/\1/p'); do
    echo "Purging stale UEFI boot entry Boot$n"
    efibootmgr -b "$n" -B >/dev/null 2>&1 || true
done

efibootmgr --create --label "$efi_label" --disk "$diskInput" --part 1 \
    --loader '\EFI\Linux\void-linux.efi' || die "efibootmgr --create failed."

newEntry=$(efibootmgr -v | grep -F "$efi_label" | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)[* ].*/\1/p' | head -n1)
[ -n "$newEntry" ] || die "Could not find the newly created UEFI boot entry for '${efi_label}'."
echo "Registered UEFI boot entry Boot${newEntry}"

commandFailure="Post-installation configuration failed (after NVRAM registration)."

ln -sf /usr/share/zoneinfo/"$timezone" /etc/localtime || die

# Doas setup 
cp /tmp/files/doas.conf /etc/doas.conf || die
chown root:root /etc/doas.conf || die
chmod 0400 /etc/doas.conf || die
ln -sf /usr/bin/doas /usr/bin/sudo || die

# Extract just the locale string (e.g., "en_US.UTF-8") from "LANG=en_US.UTF-8"
sys_locale="${locale#LANG=}"
[ -z "$sys_locale" ] && sys_locale="en_US.UTF-8"

# Generate locales now so chrooted tools (snapper etc.) don't warn about them
if [ -e /etc/default/libc-locales ]; then
    xbps-reconfigure -f glibc-locales >/dev/null 2>&1 || true
fi

if [ -z "$username" ]; then
    clear; rootPassword
else
    useradd "$username" -m -d /home/"$username" || die
    usermod -aG audio,video,kvm,wheel "$username" || die

    sed "s/@LOCALE@/${sys_locale}/g" /tmp/files/bash_profile > /home/"$username"/.bash_profile || die
    chown "$username":"$username" /home/"$username"/.bash_profile || die
    chmod 644 /home/"$username"/.bash_profile || die

    # TTY1 Autologin
    mkdir -p /etc/sv/agetty-tty1
    sed "s|@USERNAME@|$username|g" /tmp/files/agetty-tty1.conf > /etc/sv/agetty-tty1/conf || die

    # --- KDE PLASMA HARDENED DEFAULTS ---
    commandFailure="Configuring KDE Plasma defaults has failed."
    KDE_CONFIG_DIR="/home/$username/.config"
    mkdir -p "$KDE_CONFIG_DIR" || die

    for rc in ksplashrc baloofilerc krunnerrc ksmserverrc kwinrc; do
        cp "/tmp/files/kde/$rc" "$KDE_CONFIG_DIR/$rc" || die
        chmod 644 "$KDE_CONFIG_DIR/$rc" || die
    done

    # --- DYNAMIC SONNET (SPELL CHECK) CONFIG ---
    mkdir -p "$KDE_CONFIG_DIR/KDE" || die

    kde_lang="${sys_locale%%.*}" 
    
    [ "$kde_lang" = "C" ] || [ "$kde_lang" = "POSIX" ] && kde_lang="en_US"

    sed "s|@LANG@|${kde_lang}|g" /tmp/files/kde/Sonnet.conf > "$KDE_CONFIG_DIR/KDE/Sonnet.conf" || die
    chmod 644 "$KDE_CONFIG_DIR/KDE/Sonnet.conf" || die
    chown -R "$username:$username" "$KDE_CONFIG_DIR" || die

    # --- BTRFS SNAPSHOTS SETUP (SNAPPER + SNOOZE) ---
    commandFailure="Configuring Btrfs snapshots with Snapper has failed."

    # snapper is a D-Bus client: it talks to snapperd over the system bus.
    # No runit services run inside a chroot, so start a temporary bus here;
    # D-Bus activation will spawn snapperd on demand.
    mkdir -p /run/dbus || die
    tmp_dbus_pid=$(dbus-daemon --system --fork --print-pid) || die

    # /.snapshots must NOT exist yet: snapper creates the subvolume itself,
    # nested inside the root subvolume (openSUSE-style layout).
    rmdir /.snapshots 2>/dev/null || true   # drop an empty leftover mount-point dir
    [ -e /.snapshots ] && { commandFailure="/.snapshots already exists; snapper cannot create it."; die; }

    snapper -c root create-config / || die

    # Enforce strict retention policies to prevent snapshots from stacking up infinitely
    tmpfile=$(mktemp)
    sed -e 's/^NUMBER_LIMIT=.*/NUMBER_LIMIT="10"/' \
        -e 's/^TIMELINE_LIMIT_HOURLY=.*/TIMELINE_LIMIT_HOURLY="6"/' \
        -e 's/^TIMELINE_LIMIT_DAILY=.*/TIMELINE_LIMIT_DAILY="7"/' \
        -e 's/^TIMELINE_LIMIT_WEEKLY=.*/TIMELINE_LIMIT_WEEKLY="4"/' \
        -e 's/^TIMELINE_LIMIT_MONTHLY=.*/TIMELINE_LIMIT_MONTHLY="6"/' \
        -e 's/^TIMELINE_LIMIT_YEARLY=.*/TIMELINE_LIMIT_YEARLY="0"/' \
        -e 's/^NUMBER_CLEANUP=.*/NUMBER_CLEANUP="yes"/' \
        -e 's/^TIMELINE_CLEANUP=.*/TIMELINE_CLEANUP="yes"/' \
        -e 's/^TIMELINE_CREATE=.*/TIMELINE_CREATE="yes"/' \
        /etc/snapper/configs/root > "$tmpfile" && mv "$tmpfile" /etc/snapper/configs/root || die

    # Tear the temporary bus down again. Kill by PID only: the chroot shares
    # the PID namespace with the live system, so never "pkill dbus-daemon" here.
    [ -n "$tmp_dbus_pid" ] && kill "$tmp_dbus_pid" 2>/dev/null || true
    pkill -x snapperd 2>/dev/null || true

    # Enable snooze for hourly and daily tasks (which triggers snapper timeline and cleanup)
    # This completely avoids the need for cron or cronie, as snooze executes /etc/cron.{hourly,daily} scripts
    ln -s /etc/sv/snooze-hourly /var/service || die
    ln -s /etc/sv/snooze-daily /var/service || die

    clear; rootPassword
fi
