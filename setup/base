#!/bin/bash

commandFailure="Copying XBPS keys has failed."
mkdir -p /mnt/var/db/xbps/keys || die
[ -d /mnt/var/db/xbps/keys ] || { commandFailure="/mnt/var/db/xbps/keys is not a directory."; die; }

for key in /var/db/xbps/keys/*; do
    [ -f "$key" ] || continue
    cp "$key" /mnt/var/db/xbps/keys/ || die
done

# Hard gate: xbps will prompt interactively later if this is empty
[ -n "$(ls -A /mnt/var/db/xbps/keys 2>/dev/null)" ] || { commandFailure="No XBPS keys were copied."; die; }

# --- PRE-INSTALL IGNOREPKG CONFIGURATION ---
mkdir -p /mnt/etc/xbps.d
cat "$KOID_FILES_DIR/ignore.conf" >> /mnt/etc/xbps.d/ignore.conf || die

commandFailure="Base system installation has failed."

# Cleaned install list: btrfs-assistant removed; linux-lts and opendoas explicitly added
XBPS_ARCH=$ARCH install base-system btrfs-progs cryptsetup binutils chrony nano unbound linux-lts opendoas nftables

# --- UKI & INITRAMFS DEPENDENCIES ---
commandFailure="UKI/Initramfs package installation has failed."
install efibootmgr ukify systemd-boot-efistub booster plymouth

# Unbloat: Removed the manual symlink fallback. xbps-alternatives handles it natively.
system "xbps-alternatives -s booster" || die "Failed to switch to booster"

# --- PLYMOUTH CONFIGURATION ---
commandFailure="Configuring Plymouth theme has failed."

system "plymouth-set-default-theme spinner" || system "plymouth-set-default-theme text" || true

# Map the chosen GPU driver to the KMS module(s) Plymouth needs inside the
# initramfs (booster requires them in modules_force_load when plymouth is on).
# 'none' (VMs / generic displays) falls back to probing the live host.
case "$graphics" in
    amd)            drm_modules="amdgpu" ;;
    intel)          drm_modules="i915" ;;
    nvidia)         drm_modules="nvidia,nvidia_modeset" ;;
    nvidia-nouveau) drm_modules="nouveau" ;;
    *)
        drm_modules=""
        for d in /sys/class/drm/card*/device/driver; do
            [ -e "$d" ] || continue
            m="$(basename "$(readlink -f "$d")")"
            case ",$drm_modules," in *",$m,"*) ;; *) drm_modules="${drm_modules:+$drm_modules,}$m" ;; esac
        done
        ;;
esac

/usr/bin/install -Dm644 "$KOID_FILES_DIR/booster.yaml" /mnt/etc/booster.yaml || die

if [ -n "$drm_modules" ]; then
    printf 'modules_force_load: %s\n' "$drm_modules" >> /mnt/etc/booster.yaml || die
else
    # No KMS driver at all (headless / framebuffer-only VM): Plymouth can't render
    sed -i "s|^enable_plymouth:.*|enable_plymouth: false|" /mnt/etc/booster.yaml || die
fi

# --- HARDENED FSTAB CONFIGURATION ---
commandFailure="Configuring fstab has failed."

esp_uuid=$(blkid -o value -s UUID "$esp")
[ -n "$esp_uuid" ] || die "Failed to get UUID for ESP partition $esp."
root_uuid=$(blkid -o value -s UUID "$format_target")
[ -n "$root_uuid" ] || die "Failed to get UUID for root partition $format_target."

# Generate fstab from template
sed -e "s|@ESP_UUID@|$esp_uuid|g" \
    -e "s|@ROOT_UUID@|$root_uuid|g" \
    "$KOID_FILES_DIR/fstab.template" > /mnt/etc/fstab || die

# --- UKI KERNEL COMMAND LINE ---
commandFailure="Configuring UKI kernel command line has failed."
mkdir -p /mnt/etc/kernel || die

luks_uuid=$(blkid -o value -s UUID "$root")
[ -n "$luks_uuid" ] || die "Failed to get LUKS UUID for $root."
echo -n "rd.luks.name=$luks_uuid=void_root root=/dev/mapper/void_root rootfstype=btrfs rootflags=subvol=@ " > /mnt/etc/kernel/cmdline || die

if [ -n "$KERN_PARAMS" ]; then
    printf "%s\n" "$KERN_PARAMS" >> /mnt/etc/kernel/cmdline || die
else
    printf "rw quiet splash loglevel=3\n" >> /mnt/etc/kernel/cmdline || die
fi

# --- LOCALE & HOSTNAME ---
if [ "$libc" = "glibc" ]; then
    echo "$locale" > /mnt/etc/locale.conf || die
    echo "$libclocale" >> /mnt/etc/default/libc-locales || die
fi
echo "$hostname" > /mnt/etc/hostname || die

# --- NETWORK MANAGER HARDENING ---
commandFailure="Configuring NetworkManager hardening failed."
mkdir -p /mnt/etc/NetworkManager/conf.d || die

/usr/bin/install -Dm644 "$KOID_FILES_DIR/00-nm-setup.conf" \
    /mnt/etc/NetworkManager/conf.d/00-nm-setup.conf || die

# --- NTS SECURE TIME SYNC ---
commandFailure="Configuring Chrony for NTS has failed."
/usr/bin/install -Dm644 "$KOID_FILES_DIR/chrony.conf" /mnt/etc/chrony.conf || die
enableService chronyd

# --- SECURE DNS (Unbound + DoT + DNSSEC) ---
commandFailure="Configuring Unbound for Secure DNS has failed."
mkdir -p /mnt/etc/unbound /mnt/var/lib/unbound || die

/usr/bin/install -Dm644 "$KOID_FILES_DIR/unbound.conf" /mnt/etc/unbound/unbound.conf || die
/usr/bin/install -Dm644 "$KOID_FILES_DIR/resolv.conf" /mnt/etc/resolv.conf || die

enableService unbound

# --- KERNEL & SYSTEM HARDENING ---
commandFailure="Installing kernel hardening configs has failed."
mkdir -p /mnt/etc/sysctl.d /mnt/etc/profile.d /mnt/etc/modprobe.d /mnt/etc/security/limits.d || die

# 1. Install standard sysctls
/usr/bin/install -Dm644 "$KOID_FILES_DIR/99-sysctl.conf" /mnt/etc/sysctl.d/99-sysctl.conf || die

# 2. Install modprobe blacklists (e.g., blocking firewire or thunderbolt)
/usr/bin/install -Dm644 "$KOID_FILES_DIR/99-blacklist.conf" /mnt/etc/modprobe.d/99-blacklist.conf || die

# 3. Install Core Dump configs
/usr/bin/install -Dm644 "$KOID_FILES_DIR/99-disable-coredump.conf" /mnt/etc/security/limits.d/99-disable-coredump.conf || die

# Sets the default umask to 077 (user read/write/execute only)
sed -i 's/^UMASK.*/UMASK\t\t077/g' /mnt/etc/login.defs || true

# --- DOAS & FIREWALL CONFIGURATION ---
commandFailure="Configuring Doas and Firewall has failed."

/usr/bin/install -Dm0400 "$KOID_FILES_DIR/doas.conf" /mnt/etc/doas.conf || die
/usr/bin/install -Dm0400 "$KOID_FILES_DIR/nftables.conf" /mnt/etc/nftables.conf || die

# Symlink sudo to doas inside the target system
system "ln -sf /usr/bin/doas /usr/bin/sudo" || die

# Enable the firewall service on boot
enableService nftables

# --- INSTALL ADDITIONAL APPS ---
if [ -n "$extra_packages" ]; then
    commandFailure="Additional packages installation has failed."
    # shellcheck disable=SC2086
    install $extra_packages
fi

return 0
