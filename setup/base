#!/bin/bash

commandFailure="Copying XBPS keys has failed."

mkdir -p /mnt/var/db/xbps/keys || die
find /var/db/xbps/keys -maxdepth 1 -type f -exec cp {} /mnt/var/db/xbps/keys/ \; || die

# --- PRE-INSTALL IGNOREPKG CONFIGURATION ---
mkdir -p /mnt/etc/xbps.d

if [ "$su" != "sudo" ]; then
    echo "ignorepkg=sudo" >> /mnt/etc/xbps.d/ignore.conf || die
fi

if [ "$kernel" != "linux" ] ; then
    echo "ignorepkg=linux" >> /mnt/etc/xbps.d/ignore.conf || die
fi

commandFailure="Base system installation has failed."

# Added btrfs-progs, cryptsetup, snapper, snooze, and btrfs-assistant (GUI)
XBPS_ARCH=$ARCH install base-system btrfs-progs cryptsetup binutils chrony nano unbound snapper snooze btrfs-assistant

if [ "$kernel" != "linux" ] ; then
    install "$kernel"
    system "xbps-remove -RyO linux"
fi

if [ "$su" = "doas" ]; then
    install opendoas
fi

# Make nano the default editor instead of vi
command install -Dm644 "$KOID_FILES_DIR/nano.sh" /mnt/etc/profile.d/nano.sh || die

# UKI & Initramfs Dependencies
commandFailure="UKI/Initramfs package installation has failed."
install efibootmgr ukify systemd-boot-efistub "$initrd"

# linux-base pulls dracut, which owns the 20-initramfs slot by default.
# We must explicitly switch to tinyramfs so it takes over.
if [ "$initrd" = "tinyramfs" ]; then
    system "xbps-alternatives -s tinyramfs" || die "Failed to switch alternatives to tinyramfs"
fi

if [ "$repository" != "https://repo-default.voidlinux.org/current" ] && [ "$repository" != "https://repo-default.voidlinux.org/current/musl" ]; then
    xmirror -s "$repository" -r /mnt || { commandFailure="Repository configuration failed."; die ; }
fi

# --- HARDENED FSTAB CONFIGURATION ---
commandFailure="Configuring fstab has failed."

esp_uuid=$(blkid -o value -s UUID "$esp")
[ -n "$esp_uuid" ] || die "Failed to get UUID for ESP partition $esp."
root_uuid=$(blkid -o value -s UUID "$format_target")
[ -n "$root_uuid" ] || die "Failed to get UUID for root partition $format_target."

# 1. Hardened ESP (/boot/efi)
echo "UUID=$esp_uuid /boot/efi vfat rw,nosuid,nodev,noexec,umask=0022,flush 0 2" >> /mnt/etc/fstab || die

# 2. Hardened Btrfs Subvolumes (with discard=async for native TRIM support)
echo "UUID=$root_uuid / btrfs subvol=@,compress=zstd:1,discard=async,nosuid,nodev 0 0" >> /mnt/etc/fstab || die
echo "UUID=$root_uuid /home btrfs subvol=@home,compress=zstd:1,discard=async,nosuid,nodev 0 0" >> /mnt/etc/fstab || die
echo "UUID=$root_uuid /var/log btrfs subvol=@log,compress=zstd:1,discard=async,nosuid,nodev,noexec 0 0" >> /mnt/etc/fstab || die
echo "UUID=$root_uuid /var/cache btrfs subvol=@cache,compress=zstd:1,discard=async,nosuid,nodev,noexec 0 0" >> /mnt/etc/fstab || die
echo "UUID=$root_uuid /var/tmp btrfs subvol=@tmp,compress=zstd:1,discard=async,nosuid,nodev,noexec 0 0" >> /mnt/etc/fstab || die
echo "UUID=$root_uuid /.snapshots btrfs subvol=@snapshots,compress=zstd:1,discard=async 0 0" >> /mnt/etc/fstab || die

# 3. Hardened tmpfs for /tmp
echo "tmpfs /tmp tmpfs defaults,nosuid,nodev,noexec,mode=1777 0 0" >> /mnt/etc/fstab || die

# 4. UKI Kernel Command Line
mkdir -p /mnt/etc/kernel || die

luks_uuid=$(blkid -o value -s UUID "$root")
[ -n "$luks_uuid" ] || die "Failed to get LUKS UUID for $root."
echo -n "rd.luks.name=$luks_uuid=void_root root=/dev/mapper/void_root rootfstype=btrfs rootflags=subvol=@ " > /mnt/etc/kernel/cmdline || die

if [ -n "$KERN_PARAMS" ]; then
    printf "%s\n" "$KERN_PARAMS" >> /mnt/etc/kernel/cmdline || die
else
    printf "rw quiet loglevel=3\n" >> /mnt/etc/kernel/cmdline || die
fi

# --- LOCALE & HOSTNAME ---
if [ "$libc" = "glibc" ]; then
    echo "$locale" > /mnt/etc/locale.conf || die
    echo "$libclocale" >> /mnt/etc/default/libc-locales || die
fi
echo "$hostname" > /mnt/etc/hostname || die

# --- NETWORK MANAGER HARDENING ---
commandFailure="Configuring NetworkManager hardening failed."
mkdir -p /mnt/etc/NetworkManager/conf.d || die

command install -Dm644 "$KOID_FILES_DIR/00-nm-setup.conf" \
    /mnt/etc/NetworkManager/conf.d/00-nm-setup.conf || die

# --- NTS SECURE TIME SYNC ---
commandFailure="Configuring Chrony for NTS has failed."
command install -Dm644 "$KOID_FILES_DIR/chrony.conf" /mnt/etc/chrony.conf || die
enableService chronyd

# --- SECURE DNS (Unbound + DoT + DNSSEC) ---
commandFailure="Configuring Unbound for Secure DNS has failed."
mkdir -p /mnt/etc/unbound /mnt/var/lib/unbound || die

command install -Dm644 "$KOID_FILES_DIR/unbound.conf" /mnt/etc/unbound/unbound.conf || die
command install -Dm644 "$KOID_FILES_DIR/resolv.conf" /mnt/etc/resolv.conf || die

enableService unbound

# --- INSTALL ADDITIONAL APPS ---
if [ -n "$extra_packages" ]; then
    commandFailure="Additional packages installation has failed."
    # shellcheck disable=SC2086
    install $extra_packages
fi

# --- TINYRAMFS & LUKS CONFIGURATION ---
if [ "$initrd" = "tinyramfs" ]; then
    commandFailure="Configuring tinyramfs has failed."
    mkdir -p /mnt/etc/tinyramfs || die
    CONFIG_FILE="/mnt/etc/tinyramfs/config"
    
    # Detect if disk is an SSD (to enable luks_discard)
    is_ssd=0
    base_disk=$(basename "$diskInput")
    if [ -f "/sys/block/$base_disk/queue/rotational" ]; then
        if [ "$(cat /sys/block/$base_disk/queue/rotational)" -eq 0 ]; then
            is_ssd=1
        fi
    fi

    luks_uuid=$(blkid -o value -s UUID "$root")
    [ -n "$luks_uuid" ] || die "Failed to get LUKS UUID for $root."

    # Generate config with LUKS support
    cat <<EOF > "$CONFIG_FILE"
hooks="eudev,luks"
luks_root=UUID=$luks_uuid
luks_name=void_root
root=/dev/mapper/void_root
root_type=btrfs
EOF
    if [ "$is_ssd" -eq 1 ]; then
        echo 'luks_discard=yes' >> "$CONFIG_FILE"
    fi
fi

return 0
