#!/bin/bash

# --- GRAPHICS DRIVERS ---
graphicsArray=($graphics)

[ -n "$graphics" ] && commandFailure="Graphics driver installation has failed."
for i in "${graphicsArray[@]}"; do
    case $i in
        amd)
            install mesa-dri vulkan-loader mesa-vulkan-radeon mesa-vaapi linux-firmware-amd
            ;;
        intel)
            # intel-video-accel includes both modern and legacy VA-API drivers
            install mesa-dri vulkan-loader mesa-vulkan-intel intel-video-accel linux-firmware-intel
            ;;
        nvidia)
            install void-repo-nonfree nvidia-lts
            setKernelParam "nvidia_drm.modeset=1"
            ;;
        nvidia-nouveau)
            install mesa-dri mesa-nouveau-dri
            ;;
        none|*)
            install mesa-dri
            ;;
    esac
done

# --- NETWORK ---
commandFailure="Network setup has failed."
install NetworkManager
enableService NetworkManager

# --- GUI INSTALLATION (STRICTLY MINIMAL KDE WAYLAND) ---
commandFailure="GUI installation has failed"
# Core Plasma Shell (pulls in plasma-workspace, which provides startplasma-wayland)
# Explicitly listing plasma-workspace documents our dependency for the .bash_profile autologin
install plasma-desktop plasma-workspace

# Window Manager and X11 compatibility layer for Wayland
install kwin xorg-server-xwayland

# Core session, privilege, and IPC management (MUST be enabled for Plasma to function)
install elogind polkit-elogind dbus kf6-kded

# Plasma-specific integrations for audio and network system tray widgets, the default sound theme, and power profile management
install plasma-pa plasma-nm ocean-sound-theme power-profiles-daemon xdg-desktop-portal-kde kscreen

# --- GTK CONFIGURATION & THEMES ---
install kde-gtk-config breeze-gtk gtk-engine-murrine

# Basic XDG utilities
install xdg-user-dirs xdg-utils

# --- XDG AUTOSTART & SERVICES (SYSTEM-WIDE) ---
commandFailure="System-wide autostart and service setup has failed."

# Ensure the system-wide autostart directory exists inside the target system
system "mkdir -p /etc/xdg/autostart"

# --- DEFAULT PACKAGES  ---
# kinfocenter
install kinfocenter aha fwupd lm_sensors clinfo glxinfo Vulkan-Tools wayland-utils xdpyinfo mesa-demos
# file manager
install dolphin
# terminal
install konsole
# octoxbps package manager
install octoxbps
system "ln -sf /usr/share/applications/octoxbps-notifier.desktop /etc/xdg/autostart/octoxbps-notifier.desktop"
# oxygen theme
install oxygen oxygen-sounds
# screenshot
install spectacle
# archive manager
install ark

# --- EXTRA PACKAGES SETUP ---
if echo "$extra_packages" | grep -qw "chromium"; then
    install chromium-qt6
fi

if echo "$extra_packages" | grep -qw "cups"; then
    enableService cupsd
fi

if echo "$extra_packages" | grep -qw "blueman"; then
    install bluez
    enableService bluetoothd
fi

if echo "$extra_packages" | grep -qw "virt-manager"; then
    for svc in virtlockd virtlogd libvirtd; do
        [ -d "/mnt/etc/sv/$svc" ] && enableService "$svc"
    done
fi

if echo "$extra_packages" | grep -q 'libreoffice'; then
    # 1. KDE Integration
    install libreoffice-qt6 libreoffice-kde

    # 2. Locale / i18n handling
    locale_full="${locale#LANG=}"
    locale_code="${locale_full%%.*}" # e.g. de_DE.UTF-8 -> de_DE

    # Always install English as the universal fallback (skip if they are already English)
    if [[ "$locale_code" != en* ]]; then
        install libreoffice-i18n-en-US
    fi

    # 3. Dynamically find and install the user's selected locale
    # LibreOffice packages in Void usually use dashes (e.g., libreoffice-i18n-pt-BR)
    # We check a few variations (Dash, Short, Underscore) and install whichever exists.
    locale_variations=(
        "libreoffice-i18n-${locale_code//_/-}" # de-DE
        "libreoffice-i18n-${locale_code%%_*}"  # de
        "libreoffice-i18n-${locale_code}"      # de_DE
    )

    for pkg in "${locale_variations[@]}"; do
        # -n is dry-run, -y avoids interactive prompts. 
        # If xbps can resolve it in the remote repo, we install it and break.
        if xbps-install -R "$repository" -y -n "$pkg" >/dev/null 2>&1; then
            install "$pkg"
            break 
        fi
    done
fi

# --- AUDIO SERVER ---
commandFailure="Audio server installation has failed."
install pipewire wireplumber alsa-pipewire

# ALSA configuration for pipewire
system "mkdir -p /etc/alsa/conf.d"
system "ln -sf /usr/share/alsa/alsa.conf.d/50-pipewire.conf /etc/alsa/conf.d/50-pipewire.conf"
system "ln -sf /usr/share/alsa/alsa.conf.d/99-pipewire-default.conf /etc/alsa/conf.d/99-pipewire-default.conf"

system "mkdir -p /etc/pipewire/pipewire.conf.d"
system "ln -sf /usr/share/examples/wireplumber/10-wireplumber.conf /etc/pipewire/pipewire.conf.d/"
system "ln -sf /usr/share/examples/pipewire/20-pipewire-pulse.conf /etc/pipewire/pipewire.conf.d/"

# Link to autostart
system "ln -sf /usr/share/applications/pipewire.desktop /etc/xdg/autostart/pipewire.desktop"

# \-\-\- CUSTOM WALLPAPERS (SYSTEM-WIDE) ---
commandFailure="System-wide wallpapers setup has failed."

# 1. Create the target directory in the new system's mount point (/mnt)
mkdir -p /mnt/usr/share/wallpapers || die

# 2. Explicitly copy the contents of your wallpapers folder to the target system.
cp -a wallpapers/* /mnt/usr/share/wallpapers/ || die

# 3. Ensure correct ownership inside the chroot (target system)
system "chown -R root:root /usr/share/wallpapers"

# 4. Enforce correct permissions (755 for directories, 644 for files)
system "find /usr/share/wallpapers -type d -exec chmod 755 {} +"
system "find /usr/share/wallpapers -type f -exec chmod 644 {} +"

return 0
