#!/bin/sh

# ============================================================================
# Koid - Disk Setup Module
# ============================================================================
# This module handles:
# - Pre-flight checks and cleanup
# - LUKS encryption setup
# - Btrfs filesystem creation and subvolume management
# - Partition and mount configuration
# ============================================================================

# Source dependencies
. "$(dirname "$0")/../misc/libkoid" || exit 1

disk_setup() {
  local device="$1"
  local passphrase="$2"
  local layout="$3"
  local size="$4"

  # ========================================================================
  # PRE-FLIGHT CHECKS - Ensure clean state
  # ========================================================================

  _info "Running disk pre-flight checks..."

  # Step 1: Kill any lingering processes using /mnt
  if pgrep -f /mnt >/dev/null 2>&1; then
    _warn "Found processes using /mnt, killing them..."
    kill_chroot_procs
    sleep 1
  fi

  # Step 2: Unmount any remaining /mnt filesystems
  if mountpoint -q /mnt; then
    _info "Unmounting /mnt from previous run..."
    umount -l -R /mnt 2>/dev/null || true
    sleep 1
  fi

  # Step 3: Use findmnt to verify nothing is mounted at /mnt
  if findmnt /mnt >/dev/null 2>&1; then
    _error "FATAL: /mnt still has mounted filesystems from previous run:"
    findmnt /mnt
    commandFailure="Could not completely unmount /mnt. Run 'umount -l -R /mnt' manually."
    return 1
  fi

  # Step 4: Check if void_root mapper still exists
  if cryptsetup status void_root >/dev/null 2>&1; then
    _warn "Found leftover void_root mapper from previous run, closing it..."
    
    i=1
    while [ "$i" -le 3 ]; do
      if cryptsetup close void_root 2>/dev/null; then
        _info "Successfully closed void_root"
        break
      fi
      
      if [ "$i" -eq 3 ]; then
        dmsetup remove --force void_root 2>/dev/null || true
      fi
      
      sleep 1
      i=$((i + 1))
    done
  fi

  # Step 5: Verify the device node is gone
  if [ -e /dev/mapper/void_root ]; then
    if ! dmsetup info void_root >/dev/null 2>&1; then
      rm -f /dev/mapper/void_root 2>/dev/null || true
    else
      _error "FATAL: void_root mapper device still exists and cannot be removed."
      commandFailure="void_root device could not be closed."
      return 1
    fi
  fi

  # Step 6: Verify the disk device exists and is accessible
  if [ ! -b "$device" ]; then
    _error "FATAL: Device $device is not a valid block device."
    commandFailure="Invalid device: $device"
    return 1
  fi

  # Step 7: Check if device is already in use
  if lsblk -n -o MOUNTPOINT "$device" 2>/dev/null | grep -q .; then
    _error "FATAL: Device $device is already mounted."
    commandFailure="Device is already in use."
    return 1
  fi

  # Step 8: Allow udev to settle
  udevadm settle 2>/dev/null || true

  _info "Pre-flight checks passed, device is ready"

  # ========================================================================
  # BEGIN DISK SETUP
  # ========================================================================

  _info "Starting disk setup on $device with layout: $layout"

  # Wipe the device header to remove any existing partitions/signatures
  _info "Wiping device header..."
  if ! dd if=/dev/zero of="$device" bs=1M count=10 2>/dev/null; then
    commandFailure="Could not wipe device header."
    return 1
  fi

  # Ensure all I/O is flushed to disk
  sync
  sleep 0.5

  # ========================================================================
  # LUKS ENCRYPTION SETUP
  # ========================================================================

  _info "Creating LUKS2 encrypted container on $device..."
  if ! echo "$passphrase" | cryptsetup luksFormat --type luks2 \
    --pbkdf pbkdf2 --pbkdf-force-iterations 100000 \
    "$device" - 2>/dev/null; then
    commandFailure="LUKS2 formatting failed on $device."
    return 1
  fi

  sync
  sleep 0.5

  # Open the LUKS container
  _info "Opening LUKS container and mapping to void_root..."
  if ! echo "$passphrase" | cryptsetup open "$device" void_root - 2>/dev/null; then
    commandFailure="Failed to open LUKS container on $device."
    return 1
  fi

  # Wait for mapper device to appear with retries
  _info "Waiting for mapper device /dev/mapper/void_root..."
  i=1
  while [ "$i" -le 5 ]; do
    if [ -e /dev/mapper/void_root ]; then
      _info "Mapper device appeared"
      break
    fi
    sleep 0.5
    i=$((i + 1))
  done

  if [ ! -e /dev/mapper/void_root ]; then
    commandFailure="Mapper device /dev/mapper/void_root did not appear."
    cryptsetup close void_root 2>/dev/null || true
    return 1
  fi

  sync

  # ========================================================================
  # FILESYSTEM CREATION
  # ========================================================================

  _info "Creating Btrfs filesystem on /dev/mapper/void_root..."
  if ! mkfs.btrfs -f /dev/mapper/void_root 2>/dev/null; then
    commandFailure="Btrfs filesystem creation failed."
    cryptsetup close void_root 2>/dev/null || true
    return 1
  fi

  sync
  sleep 0.5

  # ========================================================================
  # MOUNT POINT PREPARATION
  # ========================================================================

  _info "Preparing mount directories..."
  if ! mkdir -p /mnt; then
    commandFailure="Could not create /mnt directory."
    cryptsetup close void_root 2>/dev/null || true
    return 1
  fi

  # ========================================================================
  # INITIAL ROOT MOUNT
  # ========================================================================

  _info "Mounting filesystem at /mnt..."
  if ! mount /dev/mapper/void_root /mnt 2>/dev/null; then
    commandFailure="Failed to mount /dev/mapper/void_root at /mnt."
    cryptsetup close void_root 2>/dev/null || true
    return 1
  fi

  sync
  sleep 0.5

  # ========================================================================
  # BTRFS SUBVOLUME CREATION
  # ========================================================================

  _info "Creating Btrfs subvolumes..."

  # Create @ subvolume (root filesystem)
  if ! btrfs subvolume create /mnt/@ 2>/dev/null; then
    commandFailure="Failed to create @ subvolume."
    umount /mnt 2>/dev/null || true
    cryptsetup close void_root 2>/dev/null || true
    return 1
  fi
  _info "Created subvolume: @"

  # Create @home subvolume
  if ! btrfs subvolume create /mnt/@home 2>/dev/null; then
    commandFailure="Failed to create @home subvolume."
    umount /mnt 2>/dev/null || true
    cryptsetup close void_root 2>/dev/null || true
    return 1
  fi
  _info "Created subvolume: @home"

  # Create @var subvolume
  if ! btrfs subvolume create /mnt/@var 2>/dev/null; then
    commandFailure="Failed to create @var subvolume."
    umount /mnt 2>/dev/null || true
    cryptsetup close void_root 2>/dev/null || true
    return 1
  fi
  _info "Created subvolume: @var"

  # Create @srv subvolume (optional but useful)
  if ! btrfs subvolume create /mnt/@srv 2>/dev/null; then
    commandFailure="Failed to create @srv subvolume."
    umount /mnt 2>/dev/null || true
    cryptsetup close void_root 2>/dev/null || true
    return 1
  fi
  _info "Created subvolume: @srv"

  # Create @tmp subvolume (optional but useful)
  if ! btrfs subvolume create /mnt/@tmp 2>/dev/null; then
    commandFailure="Failed to create @tmp subvolume."
    umount /mnt 2>/dev/null || true
    cryptsetup close void_root 2>/dev/null || true
    return 1
  fi
  _info "Created subvolume: @tmp"

  sync
  sleep 0.5

  # ========================================================================
  # UNMOUNT AND REMOUNT WITH SUBVOLUMES
  # ========================================================================

  _info "Unmounting root filesystem to remount with subvolumes..."
  if ! umount /mnt 2>/dev/null; then
    commandFailure="Failed to unmount /mnt before remounting subvolumes."
    cryptsetup close void_root 2>/dev/null || true
    return 1
  fi

  sync
  sleep 0.5

  _info "Remounting subvolumes with compression..."

  # Mount @ at /mnt with compression
  if ! mount -o subvol=@,compress=zstd,relatime /dev/mapper/void_root /mnt 2>/dev/null; then
    commandFailure="Failed to mount @ subvolume at /mnt."
    cryptsetup close void_root 2>/dev/null || true
    return 1
  fi
  _info "Mounted: / (@)"

  sync

  # Create and mount /home
  if ! mkdir -p /mnt/home; then
    commandFailure="Failed to create /home directory."
    umount /mnt 2>/dev/null || true
    cryptsetup close void_root 2>/dev/null || true
    return 1
  fi

  if ! mount -o subvol=@home,compress=zstd,relatime /dev/mapper/void_root /mnt/home 2>/dev/null; then
    commandFailure="Failed to mount @home subvolume at /mnt/home."
    umount /mnt 2>/dev/null || true
    cryptsetup close void_root 2>/dev/null || true
    return 1
  fi
  _info "Mounted: /home (@home)"

  sync

  # Create and mount /var
  if ! mkdir -p /mnt/var; then
    commandFailure="Failed to create /var directory."
    umount /mnt/home 2>/dev/null || true
    umount /mnt 2>/dev/null || true
    cryptsetup close void_root 2>/dev/null || true
    return 1
  fi

  if ! mount -o subvol=@var,compress=zstd,relatime /dev/mapper/void_root /mnt/var 2>/dev/null; then
    commandFailure="Failed to mount @var subvolume at /mnt/var."
    umount /mnt/home 2>/dev/null || true
    umount /mnt 2>/dev/null || true
    cryptsetup close void_root 2>/dev/null || true
    return 1
  fi
  _info "Mounted: /var (@var)"

  sync

  # Create and mount /srv
  if ! mkdir -p /mnt/srv; then
    commandFailure="Failed to create /srv directory."
    umount /mnt/var 2>/dev/null || true
    umount /mnt/home 2>/dev/null || true
    umount /mnt 2>/dev/null || true
    cryptsetup close void_root 2>/dev/null || true
    return 1
  fi

  if ! mount -o subvol=@srv,compress=zstd,relatime /dev/mapper/void_root /mnt/srv 2>/dev/null; then
    commandFailure="Failed to mount @srv subvolume at /mnt/srv."
    umount /mnt/var 2>/dev/null || true
    umount /mnt/home 2>/dev/null || true
    umount /mnt 2>/dev/null || true
    cryptsetup close void_root 2>/dev/null || true
    return 1
  fi
  _info "Mounted: /srv (@srv)"

  sync

  # Create and mount /tmp
  if ! mkdir -p /mnt/tmp; then
    commandFailure="Failed to create /tmp directory."
    umount /mnt/srv 2>/dev/null || true
    umount /mnt/var 2>/dev/null || true
    umount /mnt/home 2>/dev/null || true
    umount /mnt 2>/dev/null || true
    cryptsetup close void_root 2>/dev/null || true
    return 1
  fi

  if ! mount -o subvol=@tmp,compress=zstd,relatime /dev/mapper/void_root /mnt/tmp 2>/dev/null; then
    commandFailure="Failed to mount @tmp subvolume at /mnt/tmp."
    umount /mnt/srv 2>/dev/null || true
    umount /mnt/var 2>/dev/null || true
    umount /mnt/home 2>/dev/null || true
    umount /mnt 2>/dev/null || true
    cryptsetup close void_root 2>/dev/null || true
    return 1
  fi
  _info "Mounted: /tmp (@tmp)"

  sync
  sleep 0.5

  # ========================================================================
  # VERIFICATION
  # ========================================================================

  _info "Verifying mount structure..."
  
  if ! findmnt /mnt >/dev/null 2>&1; then
    commandFailure="Mount verification failed - /mnt is not mounted."
    return 1
  fi

  _info "Disk setup completed successfully"
  _info "Mount structure:"
  findmnt /mnt
  
  return 0
}
