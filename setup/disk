#!/bin/sh
# setup/disk - Partitions the disk, sets up LUKS, Btrfs subvolumes, and formats.

echo "Running setup/disk..."

# --- CLEANUP PREVIOUS INSTALLATION ---
echo "Cleaning previous installation..."

# 1a. Kill processes living in /mnt, INCLUDING holders of lazy-detached
#     mounts (readlink shows those as "... (deleted)") - the invisible Open=1.
for pdir in /proc/[0-9]*; do
    pid=${pdir#/proc/}
    [ "$pid" = "$$" ] && continue
    for what in root cwd; do
        p=$(readlink "$pdir/$what" 2>/dev/null) || continue
        case "$p" in
            /mnt|/mnt/*|"/mnt (deleted)"|/mnt/*" (deleted)")
                kill -9 "$pid" 2>/dev/null || true ;;
        esac
    done
done

# 1b. Hard-unmount everything under /mnt, deepest first. NO lazy unmount.
while :; do
    m=$(awk '$2 ~ /^\/mnt\// {print $2}' /proc/mounts | sort -r | head -n 1)
    [ -z "$m" ] && break
    umount -f "$m" 2>/dev/null || break
done
umount -f /mnt 2>/dev/null || true
sync

# 2. Close mappings backed by this disk (your working bash logic, POSIX-ified).
#    Force-close as fallback, exactly like the version that worked.
if [ -e /dev/mapper/void_root ]; then
    fuser -km /dev/mapper/void_root 2>/dev/null || true
    cryptsetup close void_root 2>/dev/null || dmsetup remove --force void_root 2>/dev/null || true
fi
for mapper in /dev/mapper/*; do
    [ -b "$mapper" ] || continue
    name=$(basename "$mapper")
    [ "$name" = "control" ] && continue
    backing=$(cryptsetup status "$name" 2>/dev/null | sed -n 's/^ *device: *//p')
    case "$backing" in
        "$diskInput"*)
            echo "Closing LUKS mapping $name..."
            fuser -km "$mapper" 2>/dev/null || true
            cryptsetup close "$name" 2>/dev/null || dmsetup remove --force "$name" 2>/dev/null || true
            ;;
    esac
done
udevadm settle --timeout=10 2>/dev/null || true

# 3. Force the kernel to drop the old table
i=1
while [ "$i" -le 5 ]; do
    blockdev --rereadpt "$diskInput" 2>/dev/null && break
    echo "Waiting for $diskInput to be released... attempt $i"
    sleep 1
    i=$((i + 1))
done
partx -u "$diskInput" 2>/dev/null || true
udevadm settle --timeout=10 2>/dev/null || true

# 4. Wipe filesystem signatures from the disk and all its partitions
wipefs --all --force "$diskInput" 2>/dev/null || true
for part in "$diskInput"*; do
    [ -b "$part" ] && wipefs --all --force "$part" 2>/dev/null || true
done

# 5. Zap GPT partition table
if command -v sgdisk >/dev/null 2>&1; then
    sgdisk --zap-all "$diskInput" 2>/dev/null || true
else
    dd if=/dev/zero of="$diskInput" bs=1M count=10 2>/dev/null || true
fi

# 6. Delete partition table via sfdisk as an extra measure
sfdisk --delete "$diskInput" 2>/dev/null || true

blockdev --rereadpt "$diskInput" 2>/dev/null || true
partx -u "$diskInput" 2>/dev/null || true
udevadm settle

# --- WIPE AND PARTITION ---
commandFailure="Disk pre-install wipe has failed."
wipefs --all -f "$diskInput" || die

commandFailure="Writing partition table has failed."
(
    echo "g"          # Create GPT
    echo "n"          # New partition
    echo "1"          # Partition 1
    echo ""           # Default first sector
    echo "+512M"      # 512M for EFI
    echo "t"          # Change type
    echo "1"          # Partition 1
    echo "1"          # EFI System
    echo "n"          # New partition
    echo "2"          # Partition 2
    echo ""           # Default first sector
    echo ""           # Use all remaining space
    echo "w"          # Write
) | fdisk -w always "$diskInput" || die

partx -u "$diskInput" 2>/dev/null || true
udevadm settle

# Set partition variables
case "$diskInput" in
    /dev/nvme*|/dev/mmcblk*) idvar="p" ;;
    *) idvar="" ;;
esac

esp="${diskInput}${idvar}1"
root="${diskInput}${idvar}2"

# Wait for partitions to appear
i=1
while [ "$i" -le 10 ]; do
    [ -b "$esp" ] && [ -b "$root" ] && break
    echo "Waiting for partitions... attempt $i"
    sleep 1
    i=$((i + 1))
done

[ -b "$esp" ] || { commandFailure="ESP partition $esp does not exist." ; die ; }
[ -b "$root" ] || { commandFailure="Root partition $root does not exist." ; die ; }

# --- PRE-FLIGHT: never format a partition a stale mapping still holds ---
if [ -n "$(ls -A "/sys/class/block/$(basename "$root")/holders" 2>/dev/null)" ]; then
    commandFailure="$root is still held by a device-mapper mapping from a previous run. Close it (cryptsetup close <name>) or reboot the live session."
    die
fi

# --- FORMAT ESP ---
commandFailure="Formatting ESP has failed."
mkfs.vfat -F 32 "$esp" || die

# --- ENCRYPTION (LUKS2 ONLY) ---
commandFailure="Encrypting partition has failed."
printf "%bEnter your encryption passphrase:%b\n" "$YELLOW" "$NC"

# Detect if disk is an SSD (rotational == 0)
is_ssd=0
base_disk=$(basename "$diskInput")
if [ -f "/sys/block/$base_disk/queue/rotational" ]; then
    if [ "$(cat /sys/block/$base_disk/queue/rotational)" -eq 0 ]; then
        is_ssd=1
    fi
fi

crypt_options="--type luks2 --batch-mode --verify-passphrase --pbkdf argon2id"
if [ "$is_ssd" -eq 1 ]; then
    crypt_options="$crypt_options --allow-discards"
fi

# shellcheck disable=SC2086
while ! cryptsetup luksFormat $crypt_options "$root"; do :; done

printf "%bOpening encrypted partition...%b\n" "$YELLOW" "$NC"
# Bounded retries: an infinite loop here spins forever on non-passphrase
# errors like "Device void_root already exists."
for attempt in 1 2 3; do
    cryptsetup luksOpen "$root" void_root && break
    if [ "$attempt" -eq 3 ]; then
        commandFailure="Opening the LUKS container failed."
        die
    fi
    echo "Failed to open LUKS container, retrying ($attempt/3)..."
done

format_target="/dev/mapper/void_root"

# --- FORMAT ROOT (BTRFS ONLY) ---
commandFailure="Formatting root as Btrfs has failed."
mkfs.btrfs -f "$format_target" || die

# --- MOUNT ROOT & CREATE SUBVOLUMES ---
commandFailure="Mounting Btrfs root has failed."
mount -o compress=zstd:1 "$format_target" /mnt || die

btrfs subvolume create /mnt/@ || die
btrfs subvolume create /mnt/@home || die
btrfs subvolume create /mnt/@log || die
btrfs subvolume create /mnt/@cache || die
btrfs subvolume create /mnt/@tmp || die

# Unmount to remount subvolumes properly
umount /mnt || die

# --- MOUNT SUBVOLUMES ---
mount -o subvol=@,compress=zstd:1,discard=async "$format_target" /mnt || die

mkdir -p /mnt/home /mnt/var/log /mnt/var/cache /mnt/var/tmp || die
mount -o subvol=@home,compress=zstd:1,discard=async "$format_target" /mnt/home || die
mount -o subvol=@log,compress=zstd:1,discard=async "$format_target" /mnt/var/log || die
mount -o subvol=@cache,compress=zstd:1,discard=async "$format_target" /mnt/var/cache || die
mount -o subvol=@tmp,compress=zstd:1,discard=async "$format_target" /mnt/var/tmp || die

mkdir -p /mnt/boot/efi || die
mount "$esp" /mnt/boot/efi || die

mkdir -p /var/cache/xbps /mnt/var/cache/xbps || die
mount --bind /var/cache/xbps /mnt/var/cache/xbps || die

for dir in dev proc sys run; do
    mkdir -p /mnt/$dir || die
    mount --rbind /$dir /mnt/$dir || die
    mount --make-rslave /mnt/$dir || die
done

return 0
