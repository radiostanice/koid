#!/bin/sh

# This script is an "orchestrator" for the other scripts that exist in the "setup" directory.

# STRICT CONSTRAINTS: btrfs, UKI (No GRUB), Booster, KDE Wayland, PipeWire, NetworkManager (with MAC randomization).

. "$(pwd)/misc/libkoid" || { echo "$(pwd)/misc/libkoid not found. Cannot continue."; exit 1; }
. "$(pwd)/setup/installer" || { commandFailure="$(pwd)/setup/installer not found. Cannot continue."; die; }

# Save-fds must exist from the very beginning, so any
# "exec 1>&3 2>&4" restore (die, traps, end of _install) is always valid.
exec 3>&1 4>&2

trap 'echo "[debug] koid exited at line $LINENO, status $?" >&2' EXIT
# Catch termination signals and trigger cleanup
trap 'die "Interrupted by user or terminated (SIGINT/SIGTERM)."' INT TERM QUIT
trap 'cleanup_mounts 2>/dev/null' EXIT

drawDialog --msgbox "Welcome!\n\nThis installer is customized for a specific, hardened setup:\n- KDE Plasma (Wayland ONLY)\n- Btrfs (Hardened fstab, Snapper & Btrfs Assistant)\n- LUKS2 Encryption only\n- UKI Bootloader only (No GRUB)\n- PipeWire + WirePlumber audio\n- NetworkManager with MAC Randomization\n\nNo changes will be made to the disk until you confirm." 0 0

# --- 1. DISK SELECTION ---
diskConfig() {
    tmpmenu=$(mktemp)
    lsblk -d -o NAME,SIZE -n -e7 > "$tmpmenu"
    set --
    while read -r name size; do
        [ -n "$name" ] && set -- "$@" "$name" "$size"
    done < "$tmpmenu"
    rm -f "$tmpmenu"

    diskInput=$(drawDialog --no-cancel --title "Available Disks" --menu "Choose the disk to install Koid Linux to (ALL DATA WILL BE WIPED):" 0 0 0 "$@")
    ret=$?
    if [ "$ret" -eq 3 ]; then
        exit 0
    elif [ -n "$diskInput" ]; then
        diskInput="/dev/$diskInput"
    else
        exit 0
    fi
    userConfig
}

# --- 2. USER & HOSTNAME ---
userConfig() {
    while :; do
        username=$(drawDialogBack --nocancel --title "Create User" --inputbox \
            "Enter your username:\n(lowercase letters, digits, '-' and '_';\nmust start with a letter or '_')" 0 0 "${username:-user}")
        ret=$?
        if [ "$ret" -eq 1 ]; then exit 0
        elif [ "$ret" -eq 3 ]; then diskConfig; return; fi
        
        [ "$username" = "root" ] && username=""
        if printf "%s" "$username" | grep -qE '^[a-z_][a-z0-9_-]*$'; then
            break
        fi
        drawDialog --title "Invalid Username" --msgbox "Invalid username: '${username:-<empty>}'.\n\nThe field is pre-filled with a safe default ('user').\nPress OK on it to accept, or type a valid name:\n- starts with a lowercase letter or '_'\n- then lowercase letters, digits, '-' or '_'" 0 0
    done

    while :; do
        hostname=$(drawDialogBack --nocancel --title "System Hostname" --inputbox \
            "Enter your system hostname:\n(letters, digits, '-' and '_'; no spaces or dots)" 0 0 "${hostname:-localhost}")
        ret=$?
        if [ "$ret" -eq 1 ]; then exit 0
        elif [ "$ret" -eq 3 ]; then diskConfig; return; fi
        
        if printf "%s" "$hostname" | grep -qE '^[a-zA-Z0-9]([a-zA-Z0-9_-]{0,62}[a-zA-Z0-9])?$'; then
            break
        fi
        drawDialog --title "Invalid Hostname" --msgbox "Invalid hostname: '${hostname:-<empty>}'.\n\nUse 1-63 characters: letters, digits, '-' or '_',\nstarting and ending with a letter or digit.\nThe field is pre-filled with the default ('localhost')." 0 0
    done
    timezoneConfig
}

# --- 3. DYNAMIC TIMEZONE ---
timezoneConfig() {
    set --
    for a in Africa America Antarctica Arctic Asia Atlantic Australia Europe Indian Pacific; do
        set -- "$@" "$a" ""
    done

    area=$(drawDialogBack --no-cancel --title "Set Timezone" --menu "Select your region:" 0 0 0 "$@")
    ret=$?
    if [ "$ret" -eq 3 ]; then userConfig; return; fi

    if [ -n "$area" ]; then
        tmpfile=$(mktemp)
        find "/usr/share/zoneinfo/$area" -type f 2>/dev/null | sed "s|^/usr/share/zoneinfo/$area/||" | sort > "$tmpfile"
        set --
        while read -r loc; do
            [ -n "$loc" ] || continue
            display_loc=$(printf "%s" "$loc" | tr '_' ' ')
            set -- "$@" "$display_loc" ""
        done < "$tmpfile"
        rm -f "$tmpfile"
        
        location=$(drawDialogBack --no-cancel --title "Set Timezone" --menu "Select your location:" 0 0 0 "$@")
        ret=$?
        if [ "$ret" -eq 3 ]; then userConfig; return; fi
        location=$(printf "%s" "$location" | tr ' ' '_')
    fi

    if [ -n "$area" ] && [ -n "$location" ]; then
        timezone="$area/$location"
    else
        timezone="UTC"
    fi
    localeConfig
}

# --- 4. DYNAMIC LOCALE ---
localeConfig() {
    tmpfile=$(mktemp)
    grep -F '.UTF-8' /etc/default/libc-locales | awk '{print $1}' | sed -e 's/^#//' | sort -u > "$tmpfile"
    set --
    while read -r i; do
        set -- "$@" "$i" ""
    done < "$tmpfile"
    rm -f "$tmpfile"
    
    localeChoice=$(drawDialogBack --no-cancel --title "Locale Selection" --menu "Please choose your system locale." 0 0 0 "$@")
    ret=$?
    if [ "$ret" -eq 3 ]; then timezoneConfig; return; fi
    
    locale="LANG=$localeChoice"
    libclocale="$localeChoice UTF-8"
    repositoryConfig
}

# --- 5. REPOSITORY MIRROR ---
repositoryConfig() {
    drawDialogBack --title "Repository Mirror" --defaultno --yesno "Would you like to set a custom repo mirror?\n\nIf 'No', the default repo will be used." 0 0
    ret=$?
    if [ "$ret" -eq 3 ]; then 
        localeConfig; return
    elif [ "$ret" -eq 0 ]; then
        xmirror
        repository=$(grep -h '^repository=' /etc/xbps.d/*-repository-main.conf 2>/dev/null | head -n 1 | cut -d= -f2 | tr -d '[:space:]')
    else
        if [ "$libc" = "musl" ]; then
            repository="https://repo-default.voidlinux.org/current/musl"
        else
            repository="https://repo-default.voidlinux.org/current"
        fi
    fi
    
    if [ "$libc" = "musl" ]; then
        ARCH="x86_64-musl"
    else
        ARCH="x86_64"
    fi

    kernelParamsConfig
}

# --- 7.1 KERNEL SECURITY PRESETS ---
kernelParamsConfig() {
    BASE_PARAMS="rw quiet loglevel=3 splash"
    
    KERN_PARAMS_DEFAULT="$BASE_PARAMS mitigations=auto pti=on vsyscall=emulate init_on_alloc=1"
    KERN_PARAMS_SECURE="$BASE_PARAMS mitigations=auto,nosmt spectre_v2=on spec_store_bypass_disable=on l1tf=full,force pti=on init_on_alloc=1 init_on_free=1 slub_debug=FZP slab_nomerge randomize_kstack_offset=on vsyscall=none random.trust_cpu=off random.trust_bootloader=off"

    preset=$(drawDialogBack --no-cancel --title "Kernel Hardening" --menu "Select a kernel security profile:" 0 0 3 \
    "default" "- Default (Good performance with baseline security)" \
    "secure" "- Max Security (CPU mitigations, memory hardening, safe for boot hardened)" \
    "custom" "- Custom (Edit the parameters manually - Base options included)")
    ret=$?
    if [ "$ret" -eq 3 ]; then kernelConfig; return; fi

    if [ "$preset" = "default" ]; then
        KERN_PARAMS="$KERN_PARAMS_DEFAULT"
    elif [ "$preset" = "secure" ]; then
        KERN_PARAMS="$KERN_PARAMS_SECURE"
    elif [ "$preset" = "custom" ]; then
        while :; do
            KERN_PARAMS=$(drawDialogBack --title "Custom Parameters" --inputbox \
                "Enter custom kernel parameters (space-separated):\n\n*Base boot options (rw, quiet, loglevel) are already included.*" 0 0 "$KERN_PARAMS_DEFAULT")
            ret=$?
            if [ "$ret" -eq 3 ]; then kernelParamsConfig; return; fi
            
            if [ -z "$(printf "%s" "$KERN_PARAMS" | tr -d ' ')" ]; then
                KERN_PARAMS="$BASE_PARAMS"
                break
            fi
            
            drawDialog --yesno "You entered:\n\n$KERN_PARAMS\n\nIs this correct?" 0 0
            if [ "$?" -eq 0 ]; then break; fi
        done
    fi
    initrdConfig
}

# --- 8. INITRAMFS CHOICE ---
initrdConfig() {
    initrd="booster"
    gpuConfig
}

# --- 9. GPU SELECTION ---
gpuConfig() {
    graphics=$(drawDialogBack --no-cancel --title "GPU Driver Selection" --menu "Select your GPU driver:\n(Note: Auto-detect can be inaccurate in VMs)" 0 0 6 \
    "auto" "- Auto-detect (lspci)" \
    "amd" "- AMD / Radeon" \
    "intel" "- Intel" \
    "nvidia" "- NVIDIA (Proprietary)" \
    "nvidia-nouveau" "- NVIDIA (Open-source Nouveau)" \
    "none" "- Generic / VM Display (virtio, qxl, vmware)")
    ret=$?
    if [ "$ret" -eq 3 ]; then initrdConfig; return; fi
    
    if [ "$graphics" = "auto" ]; then
        gpu_info=$(lspci -nn | grep -Ei "vga|3d|display")
        if printf "%s" "$gpu_info" | grep -qi "nvidia"; then
            graphics="nvidia"
        elif printf "%s" "$gpu_info" | grep -Eiq "radeon|amd|ati"; then
            graphics="amd"
        elif printf "%s" "$gpu_info" | grep -qi "intel"; then
            graphics="intel"
        else
            graphics="none"
        fi
    fi
    securebootConfig
}

# --- 10. SECURE BOOT ---
securebootConfig() {
    drawDialogBack --title "Secure Boot" --yesno "Do you want to generate Secure Boot keys and sign the kernel?\n\nThis installs 'sbctl' and adds a kernel hook to automatically sign kernels on updates." 0 0
    ret=$?
    if [ "$ret" -eq 3 ]; then gpuConfig; return
    elif [ "$ret" -eq 0 ]; then secureboot="Yes"
    else secureboot="No"; fi
    appsConfig
}

# --- 11. ADDITIONAL APPLICATIONS CHECKLIST ---
appsConfig() {
    set -- \
        "octoxbps" "OctoXBPS package manager" on \
        "kate" "KDE advanced text editor" on \
        "oxygen" "KDE theme - Recommended" on \
        "spectacle" "KDE screenshot capture utility" on \
        "chromium" "Chromium web browser" off \
        "firefox" "Firefox web browser" off \
        "flatpak" "Flatpak package management" off \
        "htop" "System monitor" off \
        "blueman" "Bluetooth GUI manager" off \
        "cups" "CUPS printing support" off

    selected=$(drawDialogBack --no-cancel --title "Additional Applications" --checklist "Select optional packages to install (Space to select, Enter to confirm):" 0 0 0 "$@")
    ret=$?
    if [ "$ret" -eq 3 ]; then securebootConfig; return; fi
    
    extra_packages=$(printf "%s" "$selected" | tr -d '"')

    if [ -n "$extra_packages" ]; then
        drawDialog --title "Selected Packages" --msgbox "The following packages will be installed:\n\n$extra_packages" 0 0
    else
        drawDialog --title "Selected Packages" --msgbox "No additional packages were selected." 0 0
    fi
    confirm
}

# --- 12. CONFIRMATION ---
confirm() {
    settings="Target disk: $diskInput (WILL BE WIPED)\n"
    settings="$settings""Hostname: $hostname\n"
    settings="$settings""User: $username\n"
    settings="$settings""Timezone: $timezone\n"
    settings="$settings""Locale: ${locale#LANG=}\n"
    settings="$settings""GPU Driver: $graphics\n"
    [ "$repository" != "default" ] && settings="$settings""Repo: $repository\n"
    [ "$secureboot" = "Yes" ] && settings="$settings""Secure Boot: Enabled\n"
    [ -n "$KERN_PARAMS" ] && settings="$settings""Kernel Params: $KERN_PARAMS\n"
    [ -n "$extra_packages" ] && settings="$settings""Extra Apps: $extra_packages\n"
    
    drawDialogBack --yes-label "Install" --no-label "Exit" --title "Installation Overview" --yesno "Selecting 'Install' will DESTROY ALL DATA on $diskInput and proceed with these options:\n\n$settings" 0 0
    ret=$?
    if [ "$ret" -eq 3 ]; then appsConfig; return
    elif [ "$ret" -eq 0 ]; then _install
    else exit 0; fi
}

# ============================================================================
# MAIN INSTALL FUNCTION - Replace entire _install() section
# ============================================================================

_install() {
  [ -z "$EDITOR" ] && EDITOR="nano"

  logFile="/tmp/koid-install.log"

  {
    printf "koid-install log\n"
    printf "date: %s\n" "$(date)"
    printf "commit: %s\n" "$(git -C "$(pwd)" rev-parse --short HEAD 2>/dev/null || echo 'unknown')"
    printf "environment: %s %s %s\n" "$libc" "$ARCH" "$(uname -r)"
    printf "\n"
    printf "user settings:\n"
    printf "%b\n" "$settings"
    printf "\n"
    printf "===== INSTALLATION LOG =====\n"
  } > "$logFile"

  # Source all setup modules and run installation
  # Use subshell with tee instead of exec to avoid buffer issues
  (
    . "$(pwd)"/misc/libkoid
    . "$(pwd)"/setup/disk
    . "$(pwd)"/setup/base
    . "$(pwd)"/setup/desktop

    commandFailure=""

    trap 'cleanup_on_exit' EXIT INT TERM

    _info "Starting koid installation..."

    disk_setup "$DISK_DEVICE" "$DISK_PASSPHRASE" "$DISK_LAYOUT" "$DISK_SIZE" || die
    _info "Disk setup complete"

    base_setup "$SYSTEM_HOSTNAME" "$SYSTEM_LOCALE" "$SYSTEM_TIMEZONE" || die
    _info "Base system setup complete"

    if [ "$DESKTOP_ENVIRONMENT" != "none" ]; then
      desktop_setup "$DESKTOP_ENVIRONMENT" || die
      _info "Desktop environment setup complete"
    fi

    _info "Installation completed successfully"

  ) 2>&1 | tee -a "$logFile"

  exit_code=$?

  # Ensure all buffers are flushed
  sync
  sleep 0.5

  # Display log to user
  clear
  _info "Installation log:"
  cat "$logFile"

  if [ "$exit_code" -eq 0 ]; then
    _success "Installation completed successfully!"
  else
    _error "Installation failed. See log above."
  fi

  rm -f "$logFile"

  return "$exit_code"
}

# Start the flow
diskConfig
