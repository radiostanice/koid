#!/bin/bash

# This script is an "orchestrator" for the other scripts that exist in the "setup" directory.

# STRICT CONSTRAINTS: btrfs, UKI (No GRUB), Booster, KDE Wayland, PipeWire, NetworkManager (with MAC randomization).

. "$(pwd)/misc/libkoid" || { echo "$(pwd)/misc/libkoid not found. Cannot continue."; exit 1; }
. "$(pwd)/setup/installer" || { commandFailure="$(pwd)/setup/installer not found. Cannot continue."; die; }

# Catch termination signals and trigger cleanup
trap 'die "Interrupted by user or terminated (SIGINT/SIGTERM)."' INT TERM QUIT

drawDialog --title "Welcome to Koid Linux" --msgbox "Welcome!\n\nThis installer will guide you through setting up a modern, secure, and privacy-focused KDE Plasma desktop.\n\nWe've done the heavy lifting under the hood so you get a fast, reliable, and ready-to-use system out of the box.\n\nPlease ensure you have backed up any important data. The installation will guide you step-by-step, and you will be asked for a final confirmation before any changes are made to your drives.\n\nPress ENTER to begin." 20 70

# --- 1. KEYMAP SELECTION ---
keymapConfig() {
    local keymaps keymapArray keymap_choice
    
    # Try to get the list of available keymaps dynamically
    if command -v localectl >/dev/null 2>&1; then
        mapfile -t keymaps < <(localectl list-keymaps 2>/dev/null)
    else
        # Fallback: search kbd keymap files directly
        mapfile -t keymaps < <(find /usr/share/kbd/keymaps/ -type f \( -name "*.map.gz" -o -name "*.map.xz" -o -name "*.map" \) 2>/dev/null | sed -e 's|.*/||' -e 's|\.map.*||' | sort -u)
    fi

    # Fallback hardcoded list in case nothing is found
    if [ ${#keymaps[@]} -eq 0 ]; then
        keymaps=("us" "uk" "de" "fr" "es" "it" "pt" "ru" "jp" "se" "no" "fi" "dk")
    fi

    for k in "${keymaps[@]}"; do
        keymapArray+=("$k" "")
    done

    keymap_choice=$(drawDialog --no-cancel --default-item "us" --title "Keyboard Layout" --menu "Select your keyboard keymap:" 0 70 12 "${keymapArray[@]}")
    
    if [ -n "$keymap_choice" ]; then
        keymap="$keymap_choice"
        loadkeys "$keymap" >/dev/null 2>&1 || true
    fi
    
    # Proceed to disk selection
    diskConfig
}

# --- 2. DISK SELECTION ---
diskConfig() {
    local diskArray=() name size
    while read -r name size; do
        [ -n "$name" ] && diskArray+=("$name" "$size")
    done < <(lsblk -d -o NAME,SIZE -n -e7)

    diskInput=$(drawDialogBack --title "Available Disks" --menu "Select the target disk for Koid Linux:" 0 70 8 "${diskArray[@]}")
    ret=$?
    if [ $ret -eq 3 ]; then keymapConfig; return
    elif [ -n "$diskInput" ]; then
        diskInput="/dev/$diskInput"
    else
        exit 0
    fi
    userConfig
}

# --- 3. USER & HOSTNAME ---
userConfig() {
    while :; do
        username=$(drawDialogBack --nocancel --title "Create User" --inputbox \
            "Enter your username:\n(lowercase letters, digits, '-' and '_';\nmust start with a letter or '_')" 20 70 "${username:-user}")
        ret=$?
        if [ $ret -eq 1 ]; then exit 0
        elif [ $ret -eq 3 ]; then diskConfig; return; fi
        
        [ "$username" = "root" ] && username=""
        if [[ "$username" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
            break
        fi
        drawDialog --title "Invalid Username" --msgbox "Invalid username: '${username:-<empty>}'.\n\nThe field is pre-filled with a safe default ('user').\nPress OK on it to accept, or type a valid name:\n- starts with a lowercase letter or '_'\n- then lowercase letters, digits, '-' or '_'" 20 70
    done

    while :; do
        hostname=$(drawDialogBack --nocancel --title "System Hostname" --inputbox \
            "Enter your system hostname:\n(letters, digits, '-' and '_'; no spaces or dots)" 20 70 "${hostname:-localhost}")
        ret=$?
        if [ $ret -eq 1 ]; then exit 0
        elif [ $ret -eq 3 ]; then diskConfig; return; fi
        
        if [[ "$hostname" =~ ^[a-zA-Z0-9]([a-zA-Z0-9_-]{0,62}[a-zA-Z0-9])?$ ]]; then
            break
        fi
        drawDialog --title "Invalid Hostname" --msgbox "Invalid hostname: '${hostname:-<empty>}'.\n\nUse 1-63 characters: letters, digits, '-' or '_',\nstarting and ending with a letter or digit.\nThe field is pre-filled with the default ('localhost')." 20 70
    done
    timezoneConfig
}

# --- 4. DYNAMIC TIMEZONE ---
timezoneConfig() {
    local areas=(Africa America Antarctica Arctic Asia Atlantic Australia Europe Indian Pacific)
    local menu_args=() a
    for a in "${areas[@]}"; do menu_args+=("$a" ""); done

    local area location
    area=$(drawDialogBack --no-cancel --default-item "Europe" --title "Set Timezone" --menu "Select your region:" 0 70 9 "${menu_args[@]}")
    ret=$?
    if [ $ret -eq 3 ]; then userConfig; return; fi

    if [ -n "$area" ]; then
        mapfile -t locations < <(find "/usr/share/zoneinfo/$area" -type f -printf '%P\n' 2>/dev/null | sort)
        local display_locations=("${locations[@]//_/ }")
        local loc_args=() l
        for l in "${display_locations[@]}"; do loc_args+=("$l" ""); done
        
        location=$(drawDialogBack --no-cancel --title "Set Timezone" --menu "Select your location:" 0 70 12 "${loc_args[@]}")
        ret=$?
        if [ $ret -eq 3 ]; then userConfig; return; fi
        location="${location// /_}"
    fi

    if [ -n "$area" ] && [ -n "$location" ]; then
        timezone="$area/$location"
    else
        timezone="UTC"
    fi
    localeConfig
}

# --- 5. DYNAMIC LOCALE ---
localeConfig() {
    local localeList tmp=() i localeChoice
    localeList=$(grep -F '.UTF-8' /etc/default/libc-locales | awk '{print $1}' | sed -e 's/^#//' | sort -u)
    for i in $localeList; do tmp+=("$i" ""); done
    
    localeChoice=$(drawDialogBack --no-cancel --default-item "en_US.UTF-8" --title "Locale Selection" --menu "Please choose your system locale." 0 70 12 "${tmp[@]}")
    ret=$?
    if [ $ret -eq 3 ]; then timezoneConfig; return; fi
    
    locale="LANG=$localeChoice"
    libclocale="$localeChoice UTF-8"
    repositoryConfig
}

# --- 6. REPOSITORY MIRROR ---
repositoryConfig() {
    drawDialogBack --title "Repository Mirror" --defaultno --yesno "Would you like to set a custom repo mirror?\n\nIf 'No', the default repo will be used." 20 70
    ret=$?
    if [ $ret -eq 3 ]; then localeConfig; return
    elif [ $ret -eq 0 ]; then
        xmirror
        repository=$(grep -h '^repository=' /etc/xbps.d/*-repository-main.conf 2>/dev/null | head -n 1 | cut -d= -f2 | tr -d '[:space:]')
    else
        [ "$libc" = "glibc" ] && repository="https://repo-default.voidlinux.org/current"
        [ "$libc" = "musl" ] && repository="https://repo-default.voidlinux.org/current/musl"
    fi
    
    [ "$libc" = "glibc" ] && ARCH="x86_64"
    [ "$libc" = "musl" ] && ARCH="x86_64-musl"
    kernelParamsConfig
}

# --- 7 KERNEL SECURITY PRESETS ---
kernelParamsConfig() {
    local BASE_PARAMS="rw quiet loglevel=3 splash"
    
    local KERN_PARAMS_DEFAULT="$BASE_PARAMS mitigations=auto pti=on vsyscall=emulate init_on_alloc=1"
    local KERN_PARAMS_SECURE="$BASE_PARAMS mitigations=auto,nosmt spectre_v2=on spec_store_bypass_disable=on l1tf=full,force pti=on init_on_alloc=1 init_on_free=1 slub_debug=FZP slab_nomerge randomize_kstack_offset=on vsyscall=none random.trust_cpu=off random.trust_bootloader=off"

    preset=$(drawDialogBack --no-cancel --title "Kernel Hardening" --menu "Select a kernel security profile:" 0 70 3 \
    "default" "- Default (Good performance with baseline security)" \
    "secure" "- Max Security (CPU mitigations, memory hardening, safe for boot hardened)" \
    "custom" "- Custom (Edit the parameters manually - Base options included)")
    ret=$?
    if [ $ret -eq 3 ]; then repositoryConfig; return; fi

    if [ "$preset" = "default" ]; then
        KERN_PARAMS="$KERN_PARAMS_DEFAULT"
    elif [ "$preset" = "secure" ]; then
        KERN_PARAMS="$KERN_PARAMS_SECURE"
    elif [ "$preset" = "custom" ]; then
        while :; do
            KERN_PARAMS=$(drawDialogBack --title "Custom Parameters" --inputbox \
                "Enter custom kernel parameters (space-separated):\n\n*Base boot options (rw, quiet, loglevel) are already included.*" 20 70 "$KERN_PARAMS_DEFAULT")
            ret=$?
            if [ $ret -eq 3 ]; then kernelParamsConfig; return; fi
            
            if [ -z "${KERN_PARAMS// }" ]; then
                KERN_PARAMS="$BASE_PARAMS"
                break
            fi
            
            drawDialog --yesno "You entered:\n\n$KERN_PARAMS\n\nIs this correct?" 20 70
            if [ $? -eq 0 ]; then break; fi
        done
    fi
    gpuConfig
}

# --- 8. GPU SELECTION ---
gpuConfig() {
    graphics=$(drawDialogBack --no-cancel --title "GPU Driver Selection" --menu "Select your GPU driver:" 0 70 6 \
    "auto" "- Auto-detect (lspci)" \
    "amd" "- AMD / Radeon" \
    "intel" "- Intel" \
    "nvidia" "- NVIDIA (Proprietary)" \
    "nvidia-nouveau" "- NVIDIA (Open-source Nouveau)" \
    "none" "- Generic / VM Display (virtio, qxl, vmware)")
    ret=$?
    if [ $ret -eq 3 ]; then kernelParamsConfig; return; fi
    if [ "$graphics" != "auto" ]; then securebootConfig; return; fi

    local ids id drivers="" vgpu="" pretty
    ids=$(lspci -n  | awk '$2 ~ /^03(00|02|80):/ {print $3}')      # 0300 VGA, 0302 3D, 0380 other
    pretty=$(lspci -nn | awk '/\[03(00|02|80)\]:/ {print "  " $0}') # names + [vendor:device]

    for id in $ids; do
        case "$id" in
            10de:*)              drivers="${drivers:+$drivers }nvidia" ;;
            1002:*)              drivers="${drivers:+$drivers }amd" ;;
            8086:*)              drivers="${drivers:+$drivers }intel" ;;
            1b36:0100)           vgpu="${vgpu:+$vgpu, }QXL (QEMU paravirtual GPU)" ;;
            1af4:1050|1af4:1000) vgpu="${vgpu:+$vgpu, }VirtIO-GPU" ;;
            1234:1111)           vgpu="${vgpu:+$vgpu, }QEMU standard VGA (bochs)" ;;
            15ad:0405)           vgpu="${vgpu:+$vgpu, }VMware SVGA" ;;
            1013:00b8)           vgpu="${vgpu:+$vgpu, }Cirrus VGA (legacy VM)" ;;
        esac
    done

    if [ -n "$drivers" ]; then
        graphics="$drivers"
        drawDialog --title "GPU Auto-Detection" --msgbox \
            "Detected display hardware:\n\n$pretty\n\nDriver selection: $drivers" 20 70
    elif [ -n "$vgpu" ]; then
        graphics="none"
        drawDialog --title "GPU Auto-Detection" --msgbox \
            "Virtual GPU detected: $vgpu\n\n$pretty\n\nThis is expected inside a VM.\nUsing 'none': mesa-dri + the in-kernel\nmodesetting/qxl/virtio-gpu driver is all that is needed." 20 70
    else
        graphics="none"
        drawDialog --title "GPU Auto-Detection" --msgbox \
            "No known GPU vendor matched.\n\n$pretty\n\nFalling back to 'none' (mesa-dri)." 20 70
    fi
    securebootConfig
}

# --- 9. SECURE BOOT ---
securebootConfig() {
    drawDialogBack --title "Secure Boot" --yesno "Do you want to generate Secure Boot keys and sign the kernel?\n\nThis installs 'sbctl' and adds a kernel hook to automatically sign kernels on updates." 20 70
    ret=$?
    if [ $ret -eq 3 ]; then gpuConfig; return
    elif [ $ret -eq 0 ]; then secureboot="Yes"
    else secureboot="No"; fi
    appsConfig
}

# --- 10. ADDITIONAL APPLICATIONS CHECKLIST ---
appsConfig() {
    local apps_list=(
        "elisa"        "KDE    | Elisa music player"               on
        "kcalc"        "KDE    | Calculator"                       on
        "gwenview"     "KDE    | Image viewer"                     on
        "kwrite"       "KDE    | Simple text editor"               on
        "okular"       "KDE    | Document viewer"                  off
        "kate"         "KDE    | Advanced text editor"             off
        "ktorrent"     "KDE    | BitTorrent client"                off
        "chromium"     "Web    | Chromium browser"                 on
        "firefox"      "Web    | Firefox browser"                  off
        "libreoffice"  "Office | LibreOffice (component sub-menu)" off
        "flatpak"      "System | Flatpak package management"       off
        "htop"         "System | htop process monitor"             off
        "blueman"      "System | Bluetooth manager (bluez)"        off
        "cups"         "System | CUPS printing support"            off
        "virt-manager" "System | virt-manager (KVM/QEMU)"          off
    )

    selected=$(drawDialogBack --no-cancel --title "Additional Applications" \
        --checklist "Select optional packages (Space toggles, Enter confirms):" 0 70 15 \
        "${apps_list[@]}")
    ret=$?
    if [ $ret -eq 3 ]; then securebootConfig; return; fi

    extra_packages=$(tr -d '"' <<<"$selected" | xargs)   # checklist prints: "tag1" "tag2"

    if [ -n "$extra_packages" ]; then
        drawDialog --title "Selected Packages" --msgbox "The following packages will be installed:\n\n$extra_packages" 20 70
    else
        drawDialog --title "Selected Packages" --msgbox "No additional packages were selected." 20 70
    fi

    # Virt-manager needs underlying dependencies to function
    if echo "$extra_packages" | grep -qw "virt-manager"; then
        extra_packages="$extra_packages libvirt qemu dnsmasq bridge-utils"
    fi

    # LibreOffice Tree-like sub-menu
    if echo "$extra_packages" | grep -qw "libreoffice"; then
        local lo_list=(
            "libreoffice-writer"  "Writer  (Word processor)" off
            "libreoffice-calc"    "Calc    (Spreadsheet)"    off
            "libreoffice-impress" "Impress (Presentations)"  off
            "libreoffice-draw"    "Draw    (Vector graphics)" off
            "libreoffice-math"    "Math    (Formula editor)"  off
            "libreoffice-base"    "Base    (Database)"        off
        )
    
        lo_selected=$(drawDialogBack --no-cancel --title "LibreOffice Components" \
            --checklist "Select LibreOffice apps to install:" 0 70 6 "${lo_list[@]}")
        ret=$?
        if [ $ret -eq 3 ]; then appsConfig; return; fi
    
        lo_clean=$(tr -d '"' <<<"$lo_selected" | xargs)
        
        # Replace the meta tag with component tags
        extra_packages=$(sed -E 's/\blibreoffice\b//g' <<<"$extra_packages" | xargs)
        extra_packages="$extra_packages $lo_clean"
    fi

    confirm
}

# --- 11. CONFIRMATION ---
confirm() {
    local settings="Target disk: $diskInput (WILL BE WIPED)\n"
    settings+="Hostname: $hostname\n"
    settings+="User: $username\n"
    settings+="Timezone: $timezone\n"
    settings+="Locale: ${locale#LANG=}\n"
    settings+="GPU Driver: $graphics\n"
    [ "$repository" != "default" ] && settings+="Repo: $repository\n"
    [ "$secureboot" = "Yes" ] && settings+="Secure Boot: Enabled\n"
    [ -n "$KERN_PARAMS" ] && settings+="Kernel Params: $KERN_PARAMS\n"
    [ -n "$extra_packages" ] && settings+="Extra Apps: $extra_packages\n"

    # height 0 = auto: warning + full summary always visible, never scrolls
    drawDialogBack --defaultno --title "FINAL CONFIRMATION" \
        --yes-label "Install" --no-label "Cancel" \
        --yesno "WARNING: DESTROY ALL DATA\n\nSelecting 'Install' will PERMANENTLY ERASE the entire contents of:\n\n    >>> $diskInput <<<\n\nOnce you proceed, this cannot be undone.\nReview the settings below, then confirm:\n\n$settings" 20 70
    ret=$?
    if [ $ret -eq 3 ]; then appsConfig; return
    elif [ $ret -eq 0 ]; then _install
    else exit 0; fi
}

# --- INSTALLATION EXECUTION ---
_install() {
    exec 3>&1 4>&2
    exec > >(tee -a "$logFile") 2>&1
    {
        echo "koid-install log"
        echo "date: $(date)"
        echo "commit: $(git -C "$(pwd)" rev-parse --short HEAD 2>/dev/null || echo unknown)"
        echo "environment: ${libc} ${ARCH} $(uname -r)"
        echo ""
        echo "user settings:"
        echo -e "$settings"
        echo ""
    } >> "$logFile"
    
echo "Starting installation..."
. "$(pwd)"/setup/disk

mkdir -p /mnt/tmp

cat <<EOF > /mnt/tmp/installerOptions
timezone=${timezone@Q}
diskInput=${diskInput@Q}
username=${username@Q}
secureboot=${secureboot@Q}
locale=${locale@Q}
extra_packages=${extra_packages@Q}
EOF
    . "$(pwd)"/setup/base
    . "$(pwd)"/setup/desktop
    
    commandFailure="System chroot setup has failed."
    cp /etc/resolv.conf /mnt/etc/resolv.conf || die 
    cp -f "$(pwd)"/misc/libkoid /mnt/tmp/libkoid || die
    cp -f "$(pwd)"/setup/chroot /mnt/tmp/chroot || die
    cp -f "$(pwd)"/misc/60-ukify /mnt/tmp/60-ukify || die
    cp -r "$(pwd)"/files /mnt/tmp/files || die
    
    system "/bin/bash /tmp/chroot"
    clear
    system "xbps-remove -RyO"

    system "find /var/cache/xbps -name '*.xbps' -delete 2>/dev/null || true"

    exec 1>&3 2>&4
    clear

    rm -f "$logFile"
    
    if [ "$secureboot" = "Yes" ]; then
        drawDialog --title "!!! CRITICAL: SECURE BOOT !!!" \
                   --msgbox "Custom Secure Boot keys were generated.\n\nYou MUST enter your BIOS/UEFI settings on your FIRST BOOT and enroll these keys (or the hash of the UKI).\n\nIf you do not do this, the system WILL NOT BOOT." 18 60
    fi

    if drawDialog --title "Installation Complete" --yes-label "Reboot" --no-label "Exit" --yesno "Installation finished successfully.\n\nTotal installer runtime: ${SECONDS} seconds." 18 60 ; then
        reboot
    else
        exit 0
    fi
}

# Start the flow
keymapConfig
